  "permissions": {
    "allow": [
      "Bash(sh bin/publish.sh)",
      "Bash(sh bin/publish.sh *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
