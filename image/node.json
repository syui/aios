{
  "name": "aios-node",
  "packages": ["nodejs", "ca-certificates"],
  "files": ["/opt/c/bin/node", "/etc/ssl/certs/ca-certificates.crt", "/etc/ssl/cert.pem"],
  "config": {
    "Entrypoint": ["/opt/c/bin/node"],
    "User": "65532:65532",
    "WorkingDir": "/home/nonroot",
    "Env": ["PATH=/opt/c/bin:/usr/local/bin:/usr/bin", "SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt"]
  }
}
