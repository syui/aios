# ca-certificates: TLS のサーバーを確かめるための、信頼する認証局の一覧 (Mozilla のもの)
# curl の配っている日付つきの cacert を、チェックサムを固定して入れる。Arch と同じ場所:
#   /etc/ssl/certs/ca-certificates.crt  (curl や git など C の拡張が使う。aios の Rust のものは持っている)
pkgname=ca-certificates
pkgver=20261020
pkgrel=1
pkgdesc='Mozilla CA certificates for TLS (PEM bundle)'
arch=('any')
url='https://curl.se/docs/caextract.html'
license=('MPL-2.0')
# 配布元の最新を見るところ (aish-pkg): ページの cacert-YYYY-MM-DD.pem の日付をつなげたものが pkgver
_latest_url=https://curl.se/docs/caextract.html
_latest_regex='cacert-([0-9]{4})-([0-9]{2})-([0-9]{2})\.pem'
source=("https://curl.se/ca/cacert-${pkgver:0:4}-${pkgver:4:2}-${pkgver:6:2}.pem")
sha256sums=('796f1389bfea13c0ed78f663b765baaff54a508e5483786bd6ece73c5e3e3cbe')

package() {
  install -Dm644 "${source[0]##*/}" "$pkgdir/etc/ssl/certs/ca-certificates.crt"
  ln -s certs/ca-certificates.crt "$pkgdir/etc/ssl/cert.pem"
}
