# fribidi: Unicode Bidirectional Algorithm library (shared, for aios)
#   pkg/c/meson.sh の meson_cross で、Zig (aarch64-linux-musl) と meson でクロスビルドする。/opt/c に入る
#   ビルドには meson、ninja、qemu-aarch64 (途中で aios 用のものを動かす) が要る
pkgname=fribidi
pkgver=1.0.18
pkgrel=2
pkgdesc='Unicode Bidirectional Algorithm library (shared, for aios)'
arch=('aarch64')
license=('LGPL-2.1-or-later')
depends=('musl')
makedepends=('meson' 'ninja' 'qemu-user')
source=("https://github.com/fribidi/fribidi/releases/download/v$pkgver/fribidi-$pkgver.tar.xz")
sha256sums=('1de5e8073d035388b71d0b2d452b1da1f8caeea8a7702997b401fe1b6250727f')

prepare() {
  rm -rf "fribidi-$pkgver"
  tar -xf "${source[0]##*/}"
}

build() {
  . "$startdir/../zig.sh"
  zig_env
  meson_cross 
  cd "fribidi-$pkgver"
  meson setup build --wrap-mode=nofallback --cross-file "$srcdir/cross.ini" --prefix="$PREFIX" --libdir=lib --buildtype=release \
    -Ddocs=false -Dbin=false -Dtests=false
  ninja -C build
}

package() {
  cd "fribidi-$pkgver"
  DESTDIR="$pkgdir" ninja -C build install
  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
