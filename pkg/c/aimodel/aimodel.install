# aimodel を入れたら、モデルを取ってくる (取れなくても入れるのはしくじらない: あとで sudo aimodel pull)。
# llama-server は動かさない: 起動のたびに 3.4 GB のモデルを読みこむと、メモリの少ない aios (Mac は 2-3 GB) では
# ほかが動けなくなる (起動したばかりの aios で読みこんで、メモリが足りずにカーネルが止まったこともある)。
# 使うときに sudo systemctl start llama-server、いつも動かすなら sudo systemctl enable --now llama-server
# (llama cli は、llama-server が動いていなければ自分でモデルを読みこむ)。上げたときは、新しいモデルがあれば
# 取ってきて、動いている llama-server だけ起こしなおす (有効かどうかは変えない)。消すときは llama-server を止めて、
# 取ってきたモデル (ai-origin なども) を消す
pull() {
  /opt/c/bin/aimodel pull || echo "aimodel: could not fetch the model now; run: sudo aimodel pull"
}

post_install() {
  pull
  echo "aimodel: llama-server is not started; to serve the model: sudo systemctl enable --now llama-server"
}

post_upgrade() {
  pull
}

pre_remove() {
  /opt/c/bin/aimodel rm
  systemctl disable llama-server > /dev/null 2>&1
  # ai-origin など、ほかに取ってきたもの (NAME.gguf.sha があるもの)
  for s in /var/lib/ai/models/ai-*.gguf.sha; do
    [ -e "$s" ] || continue
    n=${s##*/}
    /opt/c/bin/aimodel rm "${n%.gguf.sha}"
  done
}
