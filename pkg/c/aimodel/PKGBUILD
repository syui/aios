# aimodel: aios のローカルの AI (llama-server.service) のモデル (GGUF) を取ってきて使う。sudo ap -S aimodel で、
# llama.cpp といっしょに入り、入れたときに git.syui.ai の ai/os のリリース model の ai.gguf を
# /var/lib/ai/models/ai.gguf に取ってきて (ai.gguf.sha256 で確かめる)、llama-server がそれで起きる。
# モデルはパッケージにも aios.img にも git (ai/repo) にも入れない (大きいので)。モデルを替えるときは
# bin/gitea.sh model ai.gguf でリリースに置きなおす。aios では sudo aimodel pull (変わっていれば取る)。
# どこから取るかは /etc/aimodel.conf (URL と SUM)
pkgname=aimodel
pkgver=0.0.1
pkgrel=2
pkgdesc='Fetches the model (GGUF) of the local AI on aios from the ai/os release model and serves it with llama-server.service'
arch=('any')
url='https://git.syui.ai/ai/os/releases/tag/model'
license=('MIT')
depends=('llama.cpp')
backup=('etc/aimodel.conf')
install=aimodel.install
source=(aimodel aimodel.conf)
sha256sums=('SKIP' 'SKIP')

package() {
  install -Dm755 aimodel "$pkgdir/opt/c/bin/aimodel"
  install -Dm644 aimodel.conf "$pkgdir/etc/aimodel.conf"
}
