# openimageio: いろいろな画像 (PNG、JPEG、TIFF、OpenEXR、HDR、TGA、DDS、PSD ...) を読み書きし、色やサイズを変える
#   C++ のライブラリ (static, for aios)
#   Blender (画像の読み書きはほぼこれ) が使う。C++ のライブラリは静的に (imath の PKGBUILD を見て)。形式の部品
#   (プラグイン) はライブラリの中に入れる。色の変換は OpenColorIO (OIIO 3.1 ではかならず要る)。robin-map (ハッシュ
#   表。ヘッダーだけ) はビルドのときだけ使う (OIIO は自分でダウンロードしようとするので、2 つめのソースに)。
#   pugixml と fmt のヘッダーは OIIO の中のもの。WebP、HEIF、JPEG XL、OpenJPEG、RAW、GIF、FFmpeg、Ptex、OpenVDB、
#   Qt、Python のモジュール、道具 (oiiotool、iinfo ...) は入れない。pkg/c/zig.sh の cmake_cross で、
#   Zig (aarch64-linux-musl) と cmake でクロスビルドする。/opt/c に入る
#   版は Blender 5.3 が使う系列 (build_files/build_environment/cmake/versions.cmake) のいちばん新しいもの
pkgname=openimageio
pkgver=3.1.19.0
pkgrel=1
pkgdesc='Library for reading, writing, and processing images in a wide variety of formats (static, for aios)'
arch=('aarch64')
url='https://openimageio.org/'
license=('Apache-2.0')
depends=('openexr' 'imath' 'openjph' 'libdeflate' 'opencolorio' 'libtiff' 'libjpeg-turbo' 'libpng' 'zlib' 'fmt')
makedepends=('cmake' 'ninja')
_robinmap=1.4.1
source=("OpenImageIO::git+https://github.com/AcademySoftwareFoundation/OpenImageIO.git#tag=v$pkgver"
        "robin-map::git+https://github.com/Tessil/robin-map.git#tag=v$_robinmap")
sha256sums=('SKIP' 'SKIP')

build() {
  . "$startdir/../zig.sh"
  zig_env
  cmake_cross openexr imath openjph libdeflate opencolorio expat yaml-cpp pystring minizip-ng \
    libtiff libjpeg-turbo libpng zlib zstd xz fmt
  # robin-map はビルドのときだけ (sysroot に置く)
  cp -r robin-map/include/tsl "$SYSROOT/include/"
  rm -rf build
  # pystring は OpenColorIO の静的なライブラリが要る (OCIO の Findpystring は include/pystring を見ないので教える)
  cmake -S OpenImageIO -B build -G Ninja -DCMAKE_TOOLCHAIN_FILE="$srcdir/toolchain.cmake" \
    -DCMAKE_INSTALL_PREFIX="$PREFIX" -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_POSITION_INDEPENDENT_CODE=ON -DBUILD_SHARED_LIBS=OFF -DSTOP_ON_WARNING=OFF \
    -DOIIO_BUILD_TOOLS=OFF -DOIIO_BUILD_TESTS=OFF -DBUILD_TESTING=OFF -DBUILD_DOCS=OFF -DINSTALL_DOCS=OFF \
    -DUSE_PYTHON=OFF -DUSE_QT=OFF -DUSE_OPENCV=OFF -DUSE_FFMPEG=OFF -DUSE_GIF=OFF -DUSE_LIBHEIF=OFF \
    -DUSE_LIBRAW=OFF -DUSE_JXL=OFF -DUSE_OPENJPEG=OFF -DUSE_OPENVDB=OFF -DUSE_PTEX=OFF -DUSE_DCMTK=OFF \
    -DUSE_WEBP=OFF -DUSE_NUKE=OFF -DUSE_FREETYPE=OFF -DUSE_TBB=OFF -DUSE_LIBUHDR=OFF -DUSE_R3DSDK=OFF \
    -DUSE_CCACHE=OFF -DUSE_EXTERNAL_PUGIXML=OFF -DOpenImageIO_BUILD_MISSING_DEPS= \
    -Dpystring_INCLUDE_DIR="$SYSROOT/include/pystring"
  ninja -C build
}

package() {
  . "$startdir/../zig.sh"
  DESTDIR="$pkgdir" cmake --install build
  rm -rf "$pkgdir/opt/c/share/doc" "$pkgdir/opt/c/share/man"
  # cmake の設定に入ったビルドの sysroot の絶対パスを消す: libpng.so と libz.so は、すぐあとに PNG::PNG と
  # ZLIB::ZLIB もあるので要らない。Imath を探す HINTS は、この設定のとなりの Imath に
  local root=$srcdir/sysroot$PREFIX
  sed -i -e "s#$root/lib/lib[A-Za-z0-9_]*\.so;##g" -e "s#$root/lib/cmake/#\${CMAKE_CURRENT_LIST_DIR}/../#g" \
    "$pkgdir$PREFIX"/lib/cmake/OpenImageIO/*.cmake
  if grep -rq "$srcdir" "$pkgdir$PREFIX/lib/cmake" "$pkgdir$PREFIX/lib/pkgconfig"; then
    echo "openimageio: build paths left in cmake / pkg-config files" >&2
    return 1
  fi
  install -Dm644 OpenImageIO/LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
}
