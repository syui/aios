# vulkan-tools: vulkaninfo (Vulkan のドライバと GPU のことを見る) と vkcube (回る立方体) (for aios)
#   Wayland だけ (X11 はなし)。pkg/c/zig.sh の cmake_cross で、Zig (aarch64-linux-musl) と cmake でクロスビルドする
#   ビルドには cmake、ninja、このマシンの wayland-scanner (Debian / Ubuntu: libwayland-bin) が要る。/opt/c に入る
pkgname=vulkan-tools
pkgver=1.4.365
pkgrel=3
pkgdesc='Vulkan utilities: vulkaninfo and vkcube (Wayland, for aios)'
arch=('aarch64')
url='https://github.com/KhronosGroup/Vulkan-Tools'
license=('Apache-2.0')
depends=('musl' 'vulkan-loader' 'wayland')
makedepends=('cmake' 'ninja' 'vulkan-headers' 'wayland-protocols')
# wayland.xml (コアのプロトコル) は wayland のソースから (pkg/c/wayland と同じ版)
_wayland=1.26.0
source=("Vulkan-Tools::git+https://github.com/KhronosGroup/Vulkan-Tools.git#tag=v$pkgver"
        "https://gitlab.freedesktop.org/wayland/wayland/-/releases/$_wayland/downloads/wayland-$_wayland.tar.xz")
sha256sums=('SKIP'
            '64176eaa46e4969903e286f8e5ef8331affc17fdf03ac9b58381d2b23162b7a3')

build() {
  . "$startdir/../zig.sh"
  zig_env
  cmake_cross vulkan-headers vulkan-loader wayland wayland-protocols libffi
  # vkcube は wayland-scanner を pkg-config で探す。このマシンのものを sysroot に見せる
  # (pkg-config は値の頭に sysroot をつけるので、sysroot の中にこのマシンの wayland-scanner へのリンクを置く)
  local root=$srcdir/sysroot
  mkdir -p "$root/usr/bin"
  ln -sf "$(command -v wayland-scanner)" "$root/usr/bin/wayland-scanner"
  printf 'wayland_scanner=/usr/bin/wayland-scanner\nName: wayland-scanner\nDescription: host wayland-scanner\nVersion: %s\n' \
    "$(wayland-scanner --version 2>&1 | awk '{print $2}')" > "$root$PREFIX/share/pkgconfig/wayland-scanner.pc"
  # wayland.xml (コアのプロトコル) も。aios の wayland のパッケージには入れていないので、wayland のソースから
  # (前はこのマシンの /usr/share/wayland/wayland.xml を写していて、libwayland-dev のないマシンでは作れなかった)
  mkdir -p "$root$PREFIX/share/wayland"
  tar -xJOf "$srcdir/wayland-$_wayland.tar.xz" "wayland-$_wayland/protocol/wayland.xml" > "$root$PREFIX/share/wayland/wayland.xml"
  rm -rf build
  cmake -S Vulkan-Tools -B build -G Ninja -DCMAKE_TOOLCHAIN_FILE="$srcdir/toolchain.cmake" \
    -DCMAKE_INSTALL_PREFIX="$PREFIX" -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_CUBE=ON -DBUILD_VULKANINFO=ON -DBUILD_ICD=OFF -DBUILD_TESTS=OFF \
    -DBUILD_WSI_XCB_SUPPORT=OFF -DBUILD_WSI_XLIB_SUPPORT=OFF -DBUILD_WSI_WAYLAND_SUPPORT=ON \
    -DBUILD_WSI_DIRECTFB_SUPPORT=OFF -DBUILD_WSI_DISPLAY_SUPPORT=OFF \
    -DCUBE_WSI_SELECTION=WAYLAND
  ninja -C build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 Vulkan-Tools/LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE.txt"
}
