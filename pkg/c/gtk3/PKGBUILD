# gtk3: GObject-based multi-platform GUI toolkit (GTK 3; Wayland only, for aios)
#   pkg/c/meson.sh の meson_cross で、Zig (aarch64-linux-musl) と meson でクロスビルドする。/opt/c に入る
#   ビルドには meson、ninja、qemu-aarch64 (途中で aios 用のものを動かす) が要る
pkgname=gtk3
pkgver=3.24.52
pkgrel=1
pkgdesc='GObject-based multi-platform GUI toolkit (GTK 3; Wayland only, for aios)'
arch=('aarch64')
license=('LGPL-2.1-or-later')
depends=('musl' 'glib2' 'pango' 'cairo' 'gdk-pixbuf2' 'atk' 'libepoxy' 'wayland' 'libxkbcommon' 'fribidi' 'harfbuzz' 'fontconfig' 'freetype2' 'xkeyboard-config')
makedepends=('meson' 'ninja' 'qemu-user')
source=("https://download.gnome.org/sources/gtk/${pkgver%.*}/gtk-$pkgver.tar.xz")
sha256sums=('80931fa472a77b9a164f6740e3c0b444fac6770054632d35a7ff9d679e5e7b9f')

prepare() {
  rm -rf "gtk-$pkgver"
  tar -xf "${source[0]##*/}"
}

build() {
  . "$startdir/../zig.sh"
  zig_env
  meson_cross zlib libpng freetype2 expat fontconfig pixman pcre2 libffi glib2 harfbuzz fribidi cairo pango gdk-pixbuf2 atk libepoxy egl-headers wayland libxkbcommon wayland-protocols
  cd "gtk-$pkgver"
  meson setup build --wrap-mode=nofallback --cross-file "$srcdir/cross.ini" --prefix="$PREFIX" --libdir=lib --buildtype=release \
    -Dx11_backend=false -Dwayland_backend=true -Dbroadway_backend=false -Dintrospection=false -Ddemos=true -Dexamples=false -Dtests=false -Dinstalled_tests=false -Dgtk_doc=false -Dman=false -Dprint_backends=file -Dcolord=no -Dcloudproviders=false -Dtracker3=false -Dxinerama=no
  ninja -C build
}

package() {
  cd "gtk-$pkgver"
  DESTDIR="$pkgdir" ninja -C build install
  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
  # GSettings の schema をまとめる (GTK は動くときに gschemas.compiled を読む)
  glib-compile-schemas "$pkgdir/opt/c/share/glib-2.0/schemas"
}
