# toybox: ネットワークの小さな道具だけ (nc / netcat、ping、netstat、host、traceroute)。
#   ほかのコマンドは coreutils などにあるので入れない。静的なバイナリ 1 つと、名前ごとのリンクで /opt/c に入る
#   ping はカーネルの ping ソケット (SOCK_DGRAM + IPPROTO_ICMP) を使う (root でなくてよい)
pkgname=toybox
pkgver=0.8.15
pkgrel=1
pkgdesc='Network tools from toybox: nc, ping, netstat, host, traceroute (static, for aios)'
arch=('aarch64')
url='https://landley.net/toybox/'
license=('0BSD')
source=("https://landley.net/toybox/downloads/toybox-$pkgver.tar.gz")
sha256sums=('44e2bab43dfe2c171743297631ce558c6d9ed38b87a66fd751cef617574b375e')
_latest_url=https://landley.net/toybox/downloads/
_latest_regex='toybox-([0-9.]+)\.tar\.gz'

_cmds='netcat ping netstat host traceroute'

prepare() {
  rm -rf "toybox-$pkgver"
  tar -xzf "toybox-$pkgver.tar.gz"
}

build() {
  . "$startdir/../zig.sh"
  zig_env
  cd "toybox-$pkgver"
  local c
  : > mini.config
  for c in $_cmds; do
    echo "CONFIG_$(echo "$c" | tr a-z A-Z)=y" >> mini.config
  done
  # toybox は CC を 1 つのコマンドとして探すので、zig cc を包む。作るときに動かす道具 (このマシン用) は HOSTCC
  printf '#!/bin/sh\nexec zig cc -target aarch64-linux-musl "$@"\n' > "$srcdir/zcc"
  chmod +x "$srcdir/zcc"
  make allnoconfig KCONFIG_ALLCONFIG=mini.config HOSTCC=cc CC="$srcdir/zcc"
  make toybox HOSTCC=cc CC="$srcdir/zcc" CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS"
}

package() {
  cd "toybox-$pkgver"
  local d="$pkgdir/opt/c/bin" c
  install -Dm755 toybox "$d/toybox"
  for c in nc netcat ping ping6 netstat host traceroute traceroute6; do
    ln -s toybox "$d/$c"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
