#!/bin/sh
# llama.cpp の llama を、この CPU に合うもの (/opt/c/lib/llama.cpp の armv8.0 / armv8.2 / armv8.6) で動かす。
#   armv8.6: i8mm と dotprod と fp16 (Apple M2 から)、armv8.2: dotprod と fp16 (cortex-a76、Apple M1)、ほかは armv8.0。
#   LLAMA_CPU=armv8.0 などで手で選べる。llama-server は llama serve、llama-cli は llama cli と同じ
d=/opt/c/lib/llama.cpp
f=$(sed -n '/^Features/{s/^[^:]*://p;q;}' /proc/cpuinfo 2>/dev/null)
has() {
  case " $f " in *" $1 "*) return 0 ;; esac
  return 1
}
v=armv8.0
if has asimddp && has asimdhp; then
  v=armv8.2
  has i8mm && v=armv8.6
fi
v=${LLAMA_CPU:-$v}
case ${0##*/} in
  llama-server) set -- serve "$@" ;;
  llama-cli) set -- cli "$@" ;;
  *)
    # llama --version と --help も (1 本にまとめたものはサブコマンドだけ読む)
    case $1 in
      --version) shift; set -- version "$@" ;;
      --help | -h) shift; set -- help "$@" ;;
    esac
    ;;
esac
# モデルを言わなければ (-m なども LLAMA_ARG_MODEL もなければ)、llama-server.service と同じ /var/lib/ai/model.gguf
# (aimodel が取ってきたもの) を使う: llama cli だけで話せる。-m を渡したときに LLAMA_ARG_MODEL があると
# llama が warn を出すので、モデルを言う引数があれば足さない
m=/var/lib/ai/model.gguf
if [ -z "$LLAMA_ARG_MODEL" ] && [ -e "$m" ]; then
  for a in "$@"; do
    case $a in
      -m | --model | -mu | --model-url | -dr | --docker-repo | -hf | -hfr | --hf-repo | --models-dir | --models-preset) m= ;;
    esac
  done
  if [ -n "$m" ]; then
    own=1
    export LLAMA_ARG_MODEL="$m"
    # llama-server.service と同じく、考えごと (thinking) なしで答える (--reasoning on で考える)
    export LLAMA_ARG_REASONING="${LLAMA_ARG_REASONING:-off}"
    # llama bench は LLAMA_ARG_* を読まないので -m で渡す
    if [ "$1" = bench ]; then
      shift
      set -- bench -m "$m" "$@"
    fi
  fi
fi
# llama cli でモデルを言わず、llama-server.service が動いていれば、それにつなぐ (--server-base): 同じモデルをもう 1 つ
# 読みこむと、2-3 GB の aios ではメモリが足りずに読みおわらない。サーバーがまだ読みこんでいるところなら、待ってもらう
if [ "$own" = 1 ] && [ "$1" = cli ] && [ "$(systemctl is-active llama-server 2>/dev/null)" = active ]; then
  srv=http://127.0.0.1:8080
  for a in "$@"; do
    case $a in --server-base) srv= ;; esac
  done
  if [ -n "$srv" ]; then
    case $(fetch "$srv/health" 2>/dev/null) in
      *'"ok"'*)
        shift
        set -- cli --server-base "$srv" "$@"
        ;;
      *)
        echo "llama: llama-server is still loading the model; wait a little (fetch $srv/health), or use -m FILE to load one here" >&2
        exit 1
        ;;
    esac
  fi
fi
exec "$d/$v/llama" "$@"
