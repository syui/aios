# cairo: 2D graphics library (shared, for aios; no X11)
#   pkg/c/meson.sh の meson_cross で、Zig (aarch64-linux-musl) と meson でクロスビルドする。/opt/c に入る
#   ビルドには meson、ninja、qemu-aarch64 (途中で aios 用のものを動かす) が要る
pkgname=cairo
pkgver=1.18.6
pkgrel=1
pkgdesc='2D graphics library (shared, for aios; no X11)'
arch=('aarch64')
license=('LGPL-2.1-only OR MPL-1.1')
depends=('musl' 'pixman' 'freetype2' 'fontconfig' 'libpng' 'glib2')
makedepends=('meson' 'ninja' 'qemu-user')
source=("https://www.cairographics.org/releases/cairo-$pkgver.tar.xz")
sha256sums=('1c767308174337a74694da0f3ec069c271452163a1ef4540964c50c301f157d4')

prepare() {
  rm -rf "cairo-$pkgver"
  tar -xf "${source[0]##*/}"
}

build() {
  . "$startdir/../zig.sh"
  zig_env
  meson_cross zlib libpng freetype2 expat fontconfig pixman pcre2 libffi glib2
  cd "cairo-$pkgver"
  meson setup build --cross-file "$srcdir/cross.ini" --prefix="$PREFIX" --libdir=lib --buildtype=release \
    -Dxlib=disabled -Dxcb=disabled -Dquartz=disabled -Dtee=disabled -Dpng=enabled -Dfreetype=enabled -Dfontconfig=enabled -Dglib=enabled -Dspectre=disabled -Dtests=disabled -Dzlib=enabled -Dgtk_doc=false -Dsymbol-lookup=disabled -Dlzo=disabled
  ninja -C build
}

package() {
  cd "cairo-$pkgver"
  DESTDIR="$pkgdir" ninja -C build install
  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
