# xkeyboard-config: キーボードの配列のデータ (xkb)。/usr/share/X11/xkb に入る
#   libxkbcommon が名前 (us、jp など) からキーマップを組み立てるのに使う (GTK は起動のときに使う)
#   データだけなので、このマシンの meson でそのまま入れる
pkgname=xkeyboard-config
pkgver=2.48
pkgrel=1
pkgdesc='X keyboard configuration files (xkb data, used by libxkbcommon)'
arch=('any')
url='https://www.freedesktop.org/wiki/Software/XKeyboardConfig/'
license=('HPND' 'MIT')
makedepends=('meson' 'ninja' 'python')
source=("https://www.x.org/releases/individual/data/xkeyboard-config/xkeyboard-config-$pkgver.tar.xz")
sha256sums=('b77041324f0109f77161ee43743fe04baa485866af8460d31e476ad3f7648fd5')

prepare() {
  rm -rf "xkeyboard-config-$pkgver"
  tar -xf "xkeyboard-config-$pkgver.tar.xz"
}

build() {
  cd "xkeyboard-config-$pkgver"
  meson setup build --prefix=/usr -Dxorg-rules-symlinks=false -Dnls=false
  ninja -C build
}

package() {
  cd "xkeyboard-config-$pkgver"
  DESTDIR="$pkgdir" ninja -C build install
  rm -rf "$pkgdir/usr/share/man"
  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
