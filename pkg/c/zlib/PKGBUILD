# zlib: deflate の圧縮ライブラリ (C の拡張の最初の一歩。curl や git が使う)
# 静的なライブラリ (libz.a) とヘッダーを /opt/c に入れる。ビルドは pkg/c/zig.sh の Zig (aarch64-linux-musl)
pkgname=zlib
pkgver=1.3.2
pkgrel=1
pkgdesc='Compression library implementing the deflate method (static, for aios)'
arch=('aarch64')
url='https://zlib.net'
license=('Zlib')
source=("https://zlib.net/zlib-$pkgver.tar.gz")
sha256sums=('bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16')

prepare() {
  rm -rf "zlib-$pkgver"
  tar -xzf "zlib-$pkgver.tar.gz"
}

build() {
  . "$startdir/../zig.sh"
  zig_env
  cd "zlib-$pkgver"
  # configure は CC と AR を見る (クロスなので CHOST も)
  CHOST=aarch64-linux-musl ./configure --prefix="$PREFIX" --static
  make libz.a
}

package() {
  cd "zlib-$pkgver"
  make DESTDIR="$pkgdir" install
  # 文書 (man) は入れない
  rm -rf "$pkgdir/opt/c/share"
}
