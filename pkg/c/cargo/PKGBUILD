# cargo: Rust (rustc, cargo, rust-std) を aios の中で使う (aios を aios の中でビルドするため)。sudo ap -S cargo
#   Rust の公式のビルド (aarch64-unknown-linux-musl) を、入れるとき (post_install) に
#   static.rust-lang.org から取ってきて /usr に入れる (sha256 を確かめる)。大きい (取るのは 290 MB、入れると 1 GB ほど) ので
#   パッケージには入れない (git.syui.ai は 1 回 100 MB まで)。rust-std は aarch64-unknown-linux-musl
#   (aios のユーザープログラム) と aarch64-unknown-none-softfloat (aios のカーネル)。
#   リンクは rust-lld (cargo build に RUSTFLAGS='-C linker=rust-lld'、aios のソースは .cargo/config.toml で)。
#   C の部分がある crate は base-devel (zig の cc) で。入れたファイルは /usr/lib/rustlib/aios-cargo.files
pkgname=cargo
pkgver=1.99.0
pkgrel=1
pkgdesc='Rust compiler and cargo, installed from static.rust-lang.org (aarch64-unknown-linux-musl)'
arch=('any')
url='https://www.rust-lang.org'
license=('MIT' 'Apache-2.0')
depends=('musl' 'libunwind' 'curl')
optdepends=('base-devel: cc for crates with C code')
install=cargo.install

package() {
  install -Dm644 "$startdir/cargo.install" "$pkgdir/usr/share/cargo/cargo.install"
}
