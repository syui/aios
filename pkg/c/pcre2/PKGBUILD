# pcre2: Perl Compatible Regular Expressions, 8-bit (shared, for aios)
#   Zig (aarch64-linux-musl) と configure でクロスビルドする。/opt/c に入る
pkgname=pcre2
pkgver=10.45
pkgrel=1
pkgdesc='Perl Compatible Regular Expressions, 8-bit (shared, for aios)'
arch=('aarch64')
license=('BSD-3-Clause')
depends=('musl')
source=("https://github.com/PCRE2Project/pcre2/releases/download/pcre2-$pkgver/pcre2-$pkgver.tar.bz2")
sha256sums=('21547f3516120c75597e5b30a992e27a592a31950b5140e7b8bfde3f192033c4')

prepare() {
  rm -rf "pcre2-$pkgver"
  tar -xf "${source[0]##*/}"
}

build() {
  . "$startdir/../zig.sh"
  zig_env
  shared_env
  cd "pcre2-$pkgver"
  ./configure --host=aarch64-linux-musl --prefix="$PREFIX" --disable-static --enable-shared \
    --enable-pcre2-8 --disable-pcre2-16 --disable-pcre2-32 --disable-pcre2grep-libz --disable-pcre2grep-libbz2
  make
}

package() {
  # install でリンクしなおすことがある (libtool) ので Zig を使えるようにしておく
  . "$startdir/../zig.sh"
  zig_env
  cd "pcre2-$pkgver"
  make DESTDIR="$pkgdir" install
  rm -rf "$pkgdir/opt/c/share/man" "$pkgdir/opt/c/share/doc" "$pkgdir"/opt/c/lib/*.la
  install -Dm644 LICENCE.md "$pkgdir/usr/share/licenses/$pkgname/LICENCE.md"
}
