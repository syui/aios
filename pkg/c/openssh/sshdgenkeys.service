# sshd のホストの鍵を作る (足りないものだけ: ssh-keygen -A は、あるものは作りなおさない)。sshd.service から呼ばれる。
# 前は ed25519 の鍵があれば飛ばしていたので、前の版から上げたものに mldsa44-ed25519 のホストの鍵ができなかった
# (aios の init の ConditionPathExists は「どれか」の | がないので、条件はつけない)
[Unit]
Description=SSH key generation

[Service]
Type=oneshot
ExecStart=/opt/c/bin/ssh-keygen -A
