# mbedtls: 小さな TLS のライブラリ (curl や git の https に使う)。暗号は自作しない方針なので、
# よく使われているものを版とチェックサムを固定して入れる。3.6 は長く支えられる版 (LTS)
# 静的なライブラリ (libmbedtls.a, libmbedx509.a, libmbedcrypto.a) とヘッダーを /opt/c に入れる
pkgname=mbedtls
pkgver=3.6.7
pkgrel=1
pkgdesc='Small TLS library (static, for aios)'
arch=('aarch64')
url='https://www.trustedfirmware.org/projects/mbed-tls/'
license=('Apache-2.0 OR GPL-2.0-or-later')
source=("https://github.com/Mbed-TLS/mbedtls/releases/download/mbedtls-$pkgver/mbedtls-$pkgver.tar.bz2")
sha256sums=('a7e8bcbec0e6f761b4af24f25677626b35f762f68eef79c08677a363212d11f6')

prepare() {
  rm -rf "mbedtls-$pkgver"
  tar -xjf "mbedtls-$pkgver.tar.bz2"
  # スレッド (pthread) を有効に (curl は複数のスレッドから使うことがある)
  cd "mbedtls-$pkgver"
  python3 scripts/config.py set MBEDTLS_THREADING_C
  python3 scripts/config.py set MBEDTLS_THREADING_PTHREAD
}

build() {
  . "$startdir/../zig.sh"
  zig_env
  cd "mbedtls-$pkgver"
  # ライブラリだけ (テストやプログラムは作らない)
  make -j"$(nproc)" lib CC="$CC" AR="$AR" CFLAGS="$CFLAGS"
}

package() {
  cd "mbedtls-$pkgver"
  install -d "$pkgdir/opt/c/lib" "$pkgdir/opt/c/include"
  install -m644 library/libmbedtls.a library/libmbedx509.a library/libmbedcrypto.a "$pkgdir/opt/c/lib/"
  cp -r include/mbedtls include/psa "$pkgdir/opt/c/include/"
  find "$pkgdir/opt/c/include" -type f -exec chmod 644 {} +
}
