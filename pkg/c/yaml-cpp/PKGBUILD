# yaml-cpp: C++ の YAML を読み書きするライブラリ (static, for aios)
#   OpenColorIO (色の設定 config.ocio は YAML) が使う。C++ のライブラリは静的に (imath の PKGBUILD を見て)。
#   pkg/c/zig.sh の cmake_cross で、Zig (aarch64-linux-musl) と cmake でクロスビルドする。/opt/c に入る
#   版は Blender 5.3 が使う系列 (build_files/build_environment/cmake/versions.cmake) のいちばん新しいもの
pkgname=yaml-cpp
pkgver=0.8.0
pkgrel=1
pkgdesc='YAML parser and emitter in C++ (static, for aios)'
arch=('aarch64')
url='https://github.com/jbeder/yaml-cpp'
license=('MIT')
makedepends=('cmake' 'ninja')
source=("yaml-cpp::git+https://github.com/jbeder/yaml-cpp.git#tag=$pkgver")
sha256sums=('SKIP')

build() {
  . "$startdir/../zig.sh"
  zig_env
  cmake_cross
  rm -rf build
  cmake -S yaml-cpp -B build -G Ninja -DCMAKE_TOOLCHAIN_FILE="$srcdir/toolchain.cmake" \
    -DCMAKE_INSTALL_PREFIX="$PREFIX" -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_POSITION_INDEPENDENT_CODE=ON -DYAML_BUILD_SHARED_LIBS=OFF \
    -DYAML_CPP_BUILD_TESTS=OFF -DYAML_CPP_BUILD_TOOLS=OFF -DYAML_CPP_BUILD_CONTRIB=OFF
  ninja -C build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 yaml-cpp/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
