# wayland-protocols: Wayland protocol extensions (XML, for building Wayland programs)
#   pkg/c/meson.sh の meson_cross で、Zig (aarch64-linux-musl) と meson でクロスビルドする。/opt/c に入る
#   ビルドには meson、ninja、qemu-aarch64 (途中で aios 用のものを動かす) が要る
pkgname=wayland-protocols
pkgver=1.45
pkgrel=1
pkgdesc='Wayland protocol extensions (XML, for building Wayland programs)'
arch=('any')
license=('MIT')
depends=()
makedepends=('meson' 'ninja' 'qemu-user')
source=("https://gitlab.freedesktop.org/wayland/wayland-protocols/-/releases/$pkgver/downloads/wayland-protocols-$pkgver.tar.xz")
sha256sums=('4d2b2a9e3e099d017dc8107bf1c334d27bb87d9e4aff19a0c8d856d17cd41ef0')

prepare() {
  rm -rf "wayland-protocols-$pkgver"
  tar -xf "${source[0]##*/}"
}

build() {
  . "$startdir/../zig.sh"
  zig_env
  meson_cross 
  cd "wayland-protocols-$pkgver"
  meson setup build --cross-file "$srcdir/cross.ini" --prefix="$PREFIX" --libdir=lib --buildtype=release \
    -Dtests=false
  ninja -C build
}

package() {
  cd "wayland-protocols-$pkgver"
  DESTDIR="$pkgdir" ninja -C build install
  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
