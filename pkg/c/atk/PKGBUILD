# atk: Accessibility toolkit (ATK 2.38、単独で出た最後の版。at-spi2-core の中のものは libxml2 と dbus が要るので)
#   pkg/c/meson.sh の meson_cross で、Zig (aarch64-linux-musl) と meson でクロスビルドする。/opt/c に入る
#   ビルドには meson、ninja、qemu-aarch64 (途中で aios 用のものを動かす) が要る
pkgname=atk
pkgver=2.38.0
pkgrel=1
pkgdesc='Accessibility toolkit (ATK, the last standalone release; shared, for aios)'
arch=('aarch64')
license=('LGPL-2.1-or-later')
depends=('musl' 'glib2')
makedepends=('meson' 'ninja' 'qemu-user')
source=("https://download.gnome.org/sources/atk/${pkgver%.*}/atk-$pkgver.tar.xz")
sha256sums=('ac4de2a4ef4bd5665052952fe169657e65e895c5057dffb3c2a810f6191a0c36')

prepare() {
  rm -rf "atk-$pkgver"
  tar -xf "${source[0]##*/}"
}

build() {
  . "$startdir/../zig.sh"
  zig_env
  meson_cross zlib pcre2 libffi glib2
  cd "atk-$pkgver"
  meson setup build --wrap-mode=nofallback --cross-file "$srcdir/cross.ini" --prefix="$PREFIX" --libdir=lib --buildtype=release \
    -Dintrospection=false -Ddocs=false
  ninja -C build
}

package() {
  cd "atk-$pkgver"
  DESTDIR="$pkgdir" ninja -C build install
  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
