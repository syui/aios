# openssl: TLS と暗号のライブラリと openssl コマンド。aios の curl や git は mbedtls だが、OpenSSL を前提にした
#   ものがある (Rust の native-tls / openssl-sys: reqwest の既定、ai/chat と ai/courier。Python の ssl など)。
#   暗号は自作しない方針なので、版とチェックサムを固定して上流のものを入れる。
#   静的なライブラリ (libssl.a、libcrypto.a) とヘッダー、pkg-config と cmake のファイル、静的な openssl を /opt/c に。
#   静的なものしかないので、openssl-sys は何も言わなくても静的にリンクする (できたものは OpenSSL を持ち歩かない:
#   distroless の aios-static でも動く)。legacy などの provider もライブラリの中に (no-module)。
#   設定と CA は /etc/ssl (OPENSSLDIR): CA は ca-certificates の /etc/ssl/cert.pem と /etc/ssl/certs
#   作るのに perl が要る (Configure と、アセンブリを書き出す perlasm)
pkgname=openssl
pkgver=4.1.0
pkgrel=1
_latest_url=https://openssl-library.org/source/
_latest_regex='openssl-([0-9]+[.][0-9]+[.][0-9]+)[.]tar[.]gz'
pkgdesc='TLS and general-purpose cryptography library and the openssl tool (static, for aios)'
arch=('aarch64')
url='https://openssl-library.org'
license=('Apache-2.0')
depends=('ca-certificates')
backup=(etc/ssl/openssl.cnf)
source=("https://github.com/openssl/openssl/releases/download/openssl-$pkgver/openssl-$pkgver.tar.gz")
sha256sums=('50c17baf54cb008f6ce42d50deb4b28050a1aad711636cabd4b241c7e90cc2fd')

prepare() {
  rm -rf "openssl-$pkgver"
  tar -xzf "openssl-$pkgver.tar.gz"
}

build() {
  . "$startdir/../zig.sh"
  zig_env
  cd "openssl-$pkgver"
  # linux-aarch64 (アセンブリの速い道もそのまま。Zig の clang で組む)。no-shared: 静的だけ、no-module: provider も
  # 中に、no-docs と no-tests: 文書とテストは作らない。CC などは Zig (CFLAGS と LDFLAGS も環境から: openssl は -static)
  ./Configure linux-aarch64 --prefix="$PREFIX" --libdir=lib --openssldir=/etc/ssl \
    no-shared no-module no-docs no-tests \
    CC="$CC" AR="$AR" RANLIB="$RANLIB"
  make -j"$(nproc)"
}

package() {
  . "$startdir/../zig.sh"
  zig_env
  cd "openssl-$pkgver"
  make DESTDIR="$pkgdir" install_sw
  # c_rehash は perl の台本 (aios に perl はない。openssl rehash が同じことをする)
  rm -f "$pkgdir/opt/c/bin/c_rehash"
  # no-module なので provider の置き場は空
  rmdir "$pkgdir/opt/c/lib/ossl-modules"
  install -Dm644 apps/openssl.cnf "$pkgdir/etc/ssl/openssl.cnf"
  find "$pkgdir/opt/c/include" -type f -exec chmod 644 {} +
  install -Dm644 LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
