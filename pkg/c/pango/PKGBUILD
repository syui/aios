# pango: Library for layout and rendering of text (shared, for aios)
#   pkg/c/meson.sh の meson_cross で、Zig (aarch64-linux-musl) と meson でクロスビルドする。/opt/c に入る
#   ビルドには meson、ninja、qemu-aarch64 (途中で aios 用のものを動かす) が要る
pkgname=pango
pkgver=1.56.4
pkgrel=1
pkgdesc='Library for layout and rendering of text (shared, for aios)'
arch=('aarch64')
license=('LGPL-2.1-or-later')
depends=('musl' 'glib2' 'harfbuzz' 'fribidi' 'cairo' 'fontconfig')
makedepends=('meson' 'ninja' 'qemu-user')
source=("https://download.gnome.org/sources/pango/${pkgver%.*}/pango-$pkgver.tar.xz")
sha256sums=('17065e2fcc5f5a5bdbffc884c956bfc7c451a96e8c4fb2f8ad837c6413cb5a01')

prepare() {
  rm -rf "pango-$pkgver"
  tar -xf "${source[0]##*/}"
}

build() {
  . "$startdir/../zig.sh"
  zig_env
  meson_cross zlib libpng freetype2 expat fontconfig pixman pcre2 libffi glib2 harfbuzz fribidi cairo
  cd "pango-$pkgver"
  meson setup build --cross-file "$srcdir/cross.ini" --prefix="$PREFIX" --libdir=lib --buildtype=release \
    -Dintrospection=disabled -Dbuild-testsuite=false -Dbuild-examples=false -Dfontconfig=enabled -Dcairo=enabled -Dxft=disabled -Dlibthai=disabled -Dsysprof=disabled -Ddocumentation=false -Dman-pages=false
  ninja -C build
}

package() {
  cd "pango-$pkgver"
  DESTDIR="$pkgdir" ninja -C build install
  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
