# tree: ディレクトリの中を木の形で見せる。静的なバイナリ
#   Zig (aarch64-linux-musl) でクロスビルドして /opt/c に入る
pkgname=tree
pkgver=2.3.2
pkgrel=1
pkgdesc='A directory listing program displaying a depth indented list of files (static, for aios)'
arch=('aarch64')
url='https://oldmanprogrammer.net/source.php?dir=projects/tree'
license=('GPL-2.0-or-later')
source=("https://oldmanprogrammer.net/tar/tree/tree-$pkgver.tgz")
sha256sums=('6b941dd6cbecfb4d3250700e4d08d8e0c251488981dd4868b90d744234300e21')
_latest_url=https://oldmanprogrammer.net/tar/tree/
_latest_regex='tree-([0-9.]+)\.tgz'

prepare() {
  rm -rf "tree-$pkgver"
  tar -xzf "tree-$pkgver.tgz"
}

build() {
  . "$startdir/../zig.sh"
  zig_env
  cd "tree-$pkgver"
  make CC="$CC" CFLAGS="$CFLAGS -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64" LDFLAGS="$LDFLAGS"
}

package() {
  . "$startdir/../zig.sh"
  zig_env
  cd "tree-$pkgver"
  install -Dm755 tree "$pkgdir$PREFIX/bin/tree"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
