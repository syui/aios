# nftables: Linux と同じファイアウォールの道具 nft (aios のカーネルの nf_tables: kernel/src/nftables.rs、doc/aios.md の
#   「ファイアウォール (nftables)」)。静的なバイナリ 1 つで /opt/c に入る
#   nft -f FILE (決まりを入れる)、nft list ruleset (いまの決まり)、nft -j (JSON)、nft add table / chain / rule ...
#   中で使う libnftnl (nf_tables の netlink の形)、libmnl (netlink の小さなライブラリ)、jansson (nft -j の JSON) も
#   ここで静的に作る (ほかのパッケージは使わないので、別のパッケージにしない)。大きな数は mini-gmp、対話 (nft -i) はなし
pkgname=nftables
pkgver=1.1.7
pkgrel=3
_nftnl=1.3.2
_mnl=1.0.5
_jansson=2.14.1
pkgdesc='nft, the nftables firewall tool, with libnftnl, libmnl and jansson inside (static, for aios)'
arch=('aarch64')
url='https://netfilter.org/projects/nftables/'
license=('GPL-2.0-only' 'GPL-2.0-or-later' 'LGPL-2.1-or-later' 'MIT')
source=("https://netfilter.org/pub/nftables/nftables-$pkgver.tar.xz"
        "https://netfilter.org/pub/libnftnl/libnftnl-$_nftnl.tar.xz"
        "https://netfilter.org/pub/libmnl/libmnl-$_mnl.tar.bz2"
        "https://github.com/akheron/jansson/releases/download/v$_jansson/jansson-$_jansson.tar.bz2"
        version-no-netlink.patch)
sha256sums=('a6fbf060d8d4fff001517a2b94f356bb4366bfbf0ba366366f9d27cc38caa58f'
            'c97abc3409f8fa396b4462b2bb7f147a3a47a4ddc97cfa0b2f18890c9cfde8b0'
            '274b9b919ef3152bfb3da3a13c950dd60d6e2bcd54230ffeca298d03b40d0525'
            '6bd82d3043dadbcd58daaf903d974891128d22aab7dada5d399cb39094af49ce'
            'SKIP')

prepare() {
  rm -rf "nftables-$pkgver" "libnftnl-$_nftnl" "libmnl-$_mnl" "jansson-$_jansson"
  tar -xJf "nftables-$pkgver.tar.xz"
  tar -xJf "libnftnl-$_nftnl.tar.xz"
  tar -xjf "libmnl-$_mnl.tar.bz2"
  tar -xjf "jansson-$_jansson.tar.bz2"
  # nft -v (-V、--version) は netlink のソケットを開く前に版を出す (NETLINK_NETFILTER のないところでも:
  # aish の pkg_test は qemu-user で --version を動かす)。ほかのふるまいは変えない
  patch -s -p1 -d "nftables-$pkgver" < version-no-netlink.patch
  grep -q 'aios: print the version' "nftables-$pkgver/src/main.c"
}

build() {
  . "$startdir/../zig.sh"
  zig_env
  # 中で使うライブラリは $srcdir/deps に入れ、pkg-config でそこから見る
  local deps=$srcdir/deps
  export PKG_CONFIG_LIBDIR=$deps/lib/pkgconfig PKG_CONFIG_PATH=
  local conf=(--host=aarch64-linux-musl --disable-shared --enable-static)
  (cd "libmnl-$_mnl" && ./configure "${conf[@]}" --prefix="$deps" && make && make install)
  (cd "libnftnl-$_nftnl" && ./configure "${conf[@]}" --prefix="$deps" && make && make install)
  (cd "jansson-$_jansson" && ./configure "${conf[@]}" --prefix="$deps" && make && make install)
  cd "nftables-$pkgver"
  # jansson は pkg-config でなく AC_CHECK_LIB で探す
  export CPPFLAGS="-I$deps/include" LDFLAGS="$LDFLAGS -L$deps/lib"
  ./configure "${conf[@]}" --prefix="$PREFIX" --sysconfdir=/etc --with-mini-gmp --without-cli --with-json \
    --disable-man-doc
  make
}

package() {
  . "$startdir/../zig.sh"
  zig_env
  cd "nftables-$pkgver"
  install -Dm755 src/nft "$pkgdir$PREFIX/bin/nft"
  # 起動で /etc/nftables.conf を入れるもの (有効にするのは aios apply の firewall か systemctl enable nftables)
  install -Dm644 "$startdir/nftables.service" "$pkgdir/usr/lib/systemd/system/nftables.service"
  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
  install -Dm644 "$srcdir/libnftnl-$_nftnl/COPYING" "$pkgdir/usr/share/licenses/$pkgname/COPYING.libnftnl"
  install -Dm644 "$srcdir/libmnl-$_mnl/COPYING" "$pkgdir/usr/share/licenses/$pkgname/COPYING.libmnl"
  install -Dm644 "$srcdir/jansson-$_jansson/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.jansson"
}
