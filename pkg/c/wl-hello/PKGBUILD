# wl-hello: libwayland-client と xdg-shell で窓を出し、動く模様を描く小さな C のアプリ
#   aios の動的リンク (musl の libc.so)、libwayland、aiwm がつながっているかの確かめ。
#   xdg-shell の C は wayland-protocols 1.45 の stable/xdg-shell/xdg-shell.xml から wayland-scanner で作ったもの
pkgname=wl-hello
pkgver=0.0.1
pkgrel=1
pkgdesc='Tiny Wayland client (libwayland + xdg-shell) that draws a moving pattern'
arch=('aarch64')
url='https://github.com/syui/aios'
license=('MIT')
depends=('musl' 'wayland')
source=(wl-hello.c xdg-shell-client-protocol.h xdg-shell-protocol.c)
sha256sums=('SKIP' 'SKIP' 'SKIP')

build() {
  . "$startdir/../zig.sh"
  zig_env
  c_deps libffi wayland
  $CC -dynamic -O2 -s $CPPFLAGS -I. -o wl-hello wl-hello.c xdg-shell-protocol.c -L"$SYSROOT/lib" -lwayland-client
}

package() {
  install -Dm755 wl-hello "$pkgdir/opt/c/bin/wl-hello"
}
