# ai-icons: aios のアイコン (ai.png, ai.svg)。git.syui.ai/ai/app の icon/ をコミットで固定
pkgname=ai-icons
pkgver=0.0.1
pkgrel=1
pkgdesc='ai icons for the aios desktop'
arch=('any')
url='https://git.syui.ai/ai/app'
license=('custom')
source=("git+https://git.syui.ai/ai/app#commit=793ab855b58b5c9a48a5c2943f973a51b8c8f21c")
sha256sums=('SKIP')

package() {
  install -Dm644 app/icon/ai.png "$pkgdir/usr/share/icons/ai/ai.png"
  install -Dm644 app/icon/ai.svg "$pkgdir/usr/share/icons/ai/ai.svg"
  install -Dm644 app/icon/LICENSE "$pkgdir/usr/share/licenses/ai-icons/LICENSE"
}
