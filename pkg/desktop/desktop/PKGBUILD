# desktop: aios のデスクトップ (Arch の plasma のようなまとめのパッケージ)。[desktop] リポジトリ
#   aipkg -S desktop して再起動すると、画面 (virtio_gpu) とキーボードやマウス (virtio_input) の
#   モジュールが起きる (/etc/modules-load.d/desktop.conf)。窓は AIOS_DISPLAY=1 ./bin/run.sh
#   aiwm で始める (タイル型のコンポジタ。$mod+Return で端末、設定は /etc/aiwm/config)
# 入れなければ、aios は文字の画面だけの最小構成のまま
pkgname=desktop
pkgver=0.0.1
pkgrel=4
pkgdesc='aios desktop: screen and input drivers, aiwm (tiling Wayland compositor), aiterm, aifont, icons'
arch=('any')
url='https://github.com/syui/aios'
license=('MIT')
depends=('base' 'aikernel' 'aifont' 'ai-icons' 'aisplash' 'aiwm' 'aiterm')
backup=(etc/modules-load.d/desktop.conf)

package() {
  install -d "$pkgdir/etc/modules-load.d"
  cat > "$pkgdir/etc/modules-load.d/desktop.conf" <<'CONF'
# desktop: 起動のときに起こすモジュール (modprobe -l で一覧、lsmod で起きているもの)
virtio_gpu
virtio_input
CONF
  chmod 644 "$pkgdir/etc/modules-load.d/desktop.conf"
}
