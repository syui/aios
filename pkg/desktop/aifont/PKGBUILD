# aifont: aios のフォント (JetBrains Mono + Nerd Fonts + syui の字) とアイコン。git.syui.ai/ai/font をコミットで固定
#   /usr/share/fonts/aifont/aifont.ttf (デスクトップのプログラムが使う)
#   /usr/share/icons/ai/ (ai.png ai.svg など。aisplash が使う。前は ai-icons パッケージ)
pkgname=aifont
# 自作のパッケージは版を 0.0.1 にそろえる (フォントそのものの版は 2.304)。
# 前の 2.304 より新しくするため epoch=1 (aipkg -Syu で上がる)
pkgver=0.0.1
pkgrel=2
epoch=1
pkgdesc='aifont: JetBrains Mono with Nerd Fonts and custom glyphs, and the ai icons'
arch=('any')
url='https://git.syui.ai/ai/font'
license=('OFL-1.1' 'MIT')
# アイコンは ai/font にまとめた。aipkg -Syu で ai-icons を外してこれを入れる
replaces=('ai-icons')
provides=('ai-icons')
conflicts=('ai-icons')
source=("git+https://git.syui.ai/ai/font#commit=aebde5e9326be920843345c216897ca584527221")
sha256sums=('SKIP')

package() {
  install -Dm644 font/aifont.ttf "$pkgdir/usr/share/fonts/aifont/aifont.ttf"
  local f
  for f in font/icon/*.png font/icon/*.svg; do
    install -Dm644 "$f" "$pkgdir/usr/share/icons/ai/${f##*/}"
  done
  install -Dm644 font/LICENSE "$pkgdir/usr/share/licenses/aifont/LICENSE"
}
