# aifont: aios のフォント (UDEV Gothic 35NF = JetBrains Mono + BIZ UDゴシック + Nerd Fonts に syui の字) とアイコン。
#   git.syui.ai/ai/font をコミットで固定 (フォントは ai/font の Rust のプログラムで作る)
#   /usr/share/fonts/aifont/aifont.ttf (デスクトップのプログラムが使う)
#   /usr/share/icons/ai/ (ai.png ai.svg など。aisplash が使う。前は ai-icons パッケージ)
pkgname=aifont
# 自作のパッケージは版を 0.0.1 にそろえる (もとの UDEV Gothic は v2.1.0)。
# 前の 2.304 より新しくするため epoch=1 (aipkg -Syu で上がる)
pkgver=0.0.1
pkgrel=3
epoch=1
pkgdesc='aifont: UDEV Gothic 35NF (JetBrains Mono, BIZ UDGothic, Nerd Fonts) with custom glyphs, and the ai icons'
arch=('any')
url='https://git.syui.ai/ai/font'
license=('OFL-1.1' 'MIT')
# アイコンと日本語 (前の aifont-ja) は ai/font にまとめた。aipkg -Syu で ai-icons と aifont-ja を外してこれを入れる
replaces=('ai-icons' 'aifont-ja')
provides=('ai-icons' 'aifont-ja')
conflicts=('ai-icons' 'aifont-ja')
source=("git+https://git.syui.ai/ai/font#commit=0494e083d401cab50f2c3832d960bb0b5d4c87d2")
sha256sums=('SKIP')

package() {
  install -Dm644 font/aifont.ttf "$pkgdir/usr/share/fonts/aifont/aifont.ttf"
  local f
  for f in font/icon/*.png font/icon/*.svg; do
    install -Dm644 "$f" "$pkgdir/usr/share/icons/ai/${f##*/}"
  done
  install -Dm644 font/LICENSE "$pkgdir/usr/share/licenses/aifont/LICENSE"
}
