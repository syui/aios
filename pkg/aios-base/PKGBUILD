# aios (aarch64) の土台: init, sh, aipkg, systemctl, login などと /etc、ファイルシステムの並び
# このリポジトリ (aios の unix ブランチ) の user/ と etc/ から作る。bin/mkpkg.sh pkg/aios-base
pkgname=aios-base
pkgver=0.0.1
pkgrel=1
pkgdesc='aios base system: init, sh, aipkg, systemctl, login, which, swapon and /etc'
arch=('aarch64')
url='https://github.com/syui/aios'
license=('MIT')
# ログインシェルは自作の sh (/bin/sh)。bash (brush) は予備として入れておく
depends=('brush')
makedepends=('rustup')
# 手で変えることのある設定。更新しても上書きせず .pacnew を置く
backup=(etc/passwd etc/group etc/shadow etc/sudoers etc/aipkg.conf
        etc/hostname etc/hosts etc/motd etc/profile etc/shells etc/fstab etc/shrc)

pkgver() {
  cd "$startdir/../.."
  printf '0.0.1.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$startdir/../../user"
  unset CFLAGS CXXFLAGS LDFLAGS RUSTFLAGS
  cargo build --release
}

package() {
  local top=$startdir/../..
  local bin=$top/user/target/aarch64-unknown-linux-musl/release
  local p

  # Arch と同じく /usr にまとめる: /bin, /sbin, /usr/sbin は /usr/bin へのリンク
  install -d "$pkgdir/usr/bin"
  ln -s usr/bin "$pkgdir/bin"
  ln -s usr/bin "$pkgdir/sbin"
  ln -s bin "$pkgdir/usr/sbin"
  for p in init sh aipkg fetch systemctl journalctl login passwd su which mkswap swapon free resize aios ip networkd chsh; do
    install -m755 "$bin/$p" "$pkgdir/usr/bin/$p"
  done
  # カーネルは /init を動かす
  ln -s usr/bin/init "$pkgdir/init"
  # passwd と su は root の権限で動く
  chmod 4755 "$pkgdir/usr/bin/passwd" "$pkgdir/usr/bin/su"
  ln -s systemctl "$pkgdir/usr/bin/poweroff"
  ln -s systemctl "$pkgdir/usr/bin/reboot"
  ln -s swapon "$pkgdir/usr/bin/swapoff"

  cp -r "$top/etc" "$pkgdir/etc"
  chmod 600 "$pkgdir/etc/shadow"
  chmod 440 "$pkgdir/etc/sudoers"

  install -d -m700 "$pkgdir/root"
  install -d -m1777 "$pkgdir/tmp"
  install -d "$pkgdir/home" "$pkgdir/run" "$pkgdir/var/log" \
    "$pkgdir/var/lib/aipkg/local" "$pkgdir/var/cache/aipkg"
}
