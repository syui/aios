# unix: aios のカーネル (Arch の linux にあたる)。Linux の arm64 Image 形式で /boot/Image に置く
# (Arch ARM の linux-aarch64 と同じ場所。QEMU もラズパイのファームウェアもこの形式を起動でき、DTB を渡してくれる)
# EFI スタブつきで、UEFI からは loader entry (/boot/loader/entries/aios.conf) を読む
# ブートローダー (aiboot か systemd-boot) が起動する。/boot は ESP (bin/mkdisk.sh)
# root= などは entry の options に書く (なければ最初の Linux root の区画)
# QEMU では bin/run.sh が disk.img を UEFI (AAVMF) で、なければ /boot/Image を直に起動する
# initramfs は空にして作るので、ルートはディスク (bin/mkdisk.sh)
pkgname=unix
pkgver=0.0.1
pkgrel=1
pkgdesc='The aios kernel (aarch64: QEMU virt, UEFI, Raspberry Pi 3)'
arch=('aarch64')
url='https://github.com/syui/aios'
license=('MIT')
optdepends=('aiboot: UEFI で起動するとき (systemd-boot でもよい)')
makedepends=('rustup' 'llvm')
backup=(boot/loader/entries/aios.conf)

pkgver() {
  cd "$startdir/../../.."
  printf '0.0.1.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$startdir/../../.."
  unset CFLAGS CXXFLAGS LDFLAGS RUSTFLAGS
  # 作業中の開発用カーネル (target/.../debug) とは別の場所に作る
  AIOS_INITRD=none AIOS_RELEASE="$pkgver-$pkgrel" CARGO_TARGET_DIR="$srcdir/target" \
    cargo build --release -p aios
}

package() {
  install -d "$pkgdir/boot"
  local objcopy
  objcopy=$(command -v llvm-objcopy || command -v aarch64-linux-gnu-objcopy)
  "$objcopy" -O binary "$srcdir/target/aarch64-unknown-none-softfloat/release/aios" "$pkgdir/boot/Image"
  chmod 644 "$pkgdir/boot/Image"
  install -d "$pkgdir/boot/loader/entries"
  cat > "$pkgdir/boot/loader/entries/aios.conf" <<'CONF'
title   aios
linux   /Image
# options root=PARTUUID=... init=/bin/sh
CONF
  chmod 644 "$pkgdir/boot/loader/entries/aios.conf"
}
