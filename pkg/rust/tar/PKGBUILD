# aios (aarch64) 用。Arch なら: CARCH=aarch64 makepkg (ほかでは bin/mkpkg.sh pkg/rust/tar)
# uutils/tar はまだリリースがないので、コミットを決めて日付を版にする
pkgname=tar
pkgver=0.1.0.20261101
pkgrel=1
_commit=8bb814d16a21a2f5e7a273ff08763efc993f9ed4
pkgdesc='Rust implementation of tar (uutils)'
arch=('aarch64')
url='https://github.com/uutils/tar'
license=('MIT')
makedepends=('git' 'rustup')
source=("git+https://github.com/uutils/tar#commit=$_commit")
sha256sums=('SKIP')

build() {
  . "$startdir/../cross.sh"
  cd tar
  # 配布元の Cargo.lock のうち、直った版が出ているもの (cargo audit): chacha20 (0.10.1 は yanked)、ctutils
  # (RUSTSEC-2026-0385)
  cargo_update chacha20@0.10.2 ctutils@0.4.4
  musl_build --bin tarapp
}

package() {
  cd tar
  install -Dm755 target/aarch64-unknown-linux-musl/release/tarapp "$pkgdir/usr/bin/tar"
}
