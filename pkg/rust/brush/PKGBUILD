# aios (aarch64) 用。Arch なら: CARCH=aarch64 makepkg (ほかでは bin/mkpkg.sh pkg/rust/brush)
pkgname=brush
pkgver=0.4.0
pkgrel=3
pkgdesc='Bash/POSIX-compatible shell implemented in Rust'
arch=('aarch64')
url='https://github.com/reubeno/brush'
license=('MIT')
makedepends=('git' 'rustup')
source=("git+https://github.com/reubeno/brush#tag=brush-shell-v$pkgver")
sha256sums=('SKIP')

prepare() {
  cd brush
  # bash の readline と同じく、TERM=dumb の端末では飾りのない入力にする
  # (カーソル位置の問い合わせ ESC[6n に答えない端末でもログインできるように)
  sed -i 's|if std::io::stdin().is_terminal() \&\& will_run_interactively(args) {|if std::io::stdin().is_terminal() \&\& will_run_interactively(args) \&\& std::env::var("TERM").map_or(true, \|t\| t != "dumb") {|' \
    brush-shell/src/entry.rs
  grep -q 'TERM").map_or' brush-shell/src/entry.rs
}

build() {
  . "$startdir/../cross.sh"
  cd brush
  # 配布元の Cargo.lock のうち、直った版が出ているもの (cargo audit): crossbeam-epoch (RUSTSEC-2026-0204)、
  # anyhow (RUSTSEC-2026-0190)、memmap2 (RUSTSEC-2026-0186)、chacha20 (0.10.0 は yanked)。
  # quick-xml (RUSTSEC-2026-0194 RUSTSEC-2026-0195) はテストの junit-report だけが使う (brush には入らない)。
  # lru (RUSTSEC-2026-0253) は num-prime (factor) が 0.16 のままで、直った 0.18 に上げられない
  cargo_update crossbeam-epoch@0.9.21 anyhow@1.0.104 memmap2@0.9.11 chacha20@0.10.2
  musl_build --bin brush
}

package() {
  cd brush
  install -Dm755 target/aarch64-unknown-linux-musl/release/brush "$pkgdir/usr/bin/brush"
  # bash として呼ばれてもいいように
  ln -s brush "$pkgdir/usr/bin/bash"
}
