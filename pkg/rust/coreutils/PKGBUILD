# aios (aarch64) 用。Arch なら: CARCH=aarch64 makepkg (ほかでは bin/mkpkg.sh pkg/rust/coreutils)
pkgname=coreutils
pkgver=0.12.0
pkgrel=3
pkgdesc='Cross-platform Rust rewrite of the GNU coreutils (uutils)'
arch=('aarch64')
url='https://github.com/uutils/coreutils'
license=('MIT')
makedepends=('git' 'rustup' 'aarch64-linux-gnu-gcc')
source=("git+https://github.com/uutils/coreutils#tag=$pkgver")
sha256sums=('SKIP')

build() {
  . "$startdir/../cross.sh"
  cd coreutils
  # 配布元の Cargo.lock のうち、直った版が出ているもの (cargo audit): yoke-derive (0.8.3 は yanked)。
  # lru (RUSTSEC-2026-0253) は num-prime (factor) が 0.16 のままで、直った 0.18 に上げられない。
  # zip 8.6.0 (RUSTSEC-2026-0367 RUSTSEC-2026-0368 RUSTSEC-2026-0369、zip をほどくときの穴。直ったのは 9.0.0) は
  # uudoc (説明書を作るもの) だけが使い、ここで作るものには入らない
  cargo_update yoke-derive@0.8.4
  musl_build --no-default-features --features feat_os_unix_musl
}

package() {
  cd coreutils
  local out=target/aarch64-unknown-linux-musl/release
  install -Dm755 "$out/coreutils" "$pkgdir/usr/bin/coreutils"
  # 1 つのバイナリを、入っているコマンドの名前で呼ぶ
  local f n
  for f in "$out"/deps/libuu_*.rlib; do
    n=${f##*/libuu_}
    n=${n%%-*}
    case "$n" in *_common) continue ;; esac
    [ -e "$pkgdir/usr/bin/$n" ] || ln -s coreutils "$pkgdir/usr/bin/$n"
  done
  # test は [ という名前でも呼ばれる
  [ -e "$pkgdir/usr/bin/test" ] && ln -s coreutils "$pkgdir/usr/bin/["
}
