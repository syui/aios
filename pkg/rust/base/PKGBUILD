# aios (aarch64) の土台: init, aish, aipkg, systemctl, login などと /etc、ファイルシステムの並び
# このリポジトリ (aios の unix ブランチ) の user/ と etc/ から作る。bin/mkpkg.sh pkg/rust/base
pkgname=base
pkgver=0.0.1
pkgrel=1
pkgdesc='aios base system: init, aish (and its basic plugins), aipkg, systemctl, login, which, swapon and /etc'
arch=('aarch64')
url='https://github.com/syui/aios'
license=('MIT')
# base + aikernel + aiboot で使える aios になる (Arch の base + linux のように)。
# ログインシェルは自作の aish。/bin/sh は aish へのリンク (bash と同じやり方)。bash (brush) は予備として入れておく。awk は作りかけなので入れない
depends=('coreutils' 'grep' 'sed' 'findutils' 'diffutils' 'tar' 'sudo-rs' 'brush')
makedepends=('rustup')
# aish の grep ツールと C-f / C-g は、ripgrep があればそれを使う (.gitignore を読む、速い)
optdepends=('ripgrep: faster grep tool and C-f / C-g in aish')
# 手で変えることのある設定。更新しても上書きせず .pacnew を置く
backup=(etc/passwd etc/group etc/shadow etc/sudoers etc/aipkg.conf
        etc/hostname etc/hosts etc/motd etc/profile etc/shells etc/fstab etc/aishrc
        etc/default/useradd)

pkgver() {
  cd "$startdir/../../.."
  printf '0.0.1.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$startdir/../../../user"
  unset CFLAGS CXXFLAGS LDFLAGS RUSTFLAGS
  cargo build --release
  # aish の基本のプラグイン (補完、グレーの候補、C-r などのキー)。aish とは別のプログラムで、/etc/aishrc で読む
  cd ../shell
  cargo build --release -p aish-complete -p aish-suggest -p aish-pick -p aish-edit -p aish-wait -p aish-map
}

package() {
  local top=$startdir/../../..
  local bin=$top/user/target/aarch64-unknown-linux-musl/release
  local p

  # Arch と同じく /usr にまとめる: /bin, /sbin, /usr/sbin は /usr/bin へのリンク
  install -d "$pkgdir/usr/bin"
  ln -s usr/bin "$pkgdir/bin"
  ln -s usr/bin "$pkgdir/sbin"
  ln -s bin "$pkgdir/usr/sbin"
  # 共有ライブラリも /usr/lib にまとめる (/lib/ld-musl-aarch64.so.1 などはここを通る)
  install -d "$pkgdir/usr/lib"
  ln -s usr/lib "$pkgdir/lib"
  for p in init aish aipkg fetch systemctl journalctl login passwd su which mkswap swapon free resize aios ip networkd chsh modprobe useradd; do
    install -m755 "$bin/$p" "$pkgdir/usr/bin/$p"
  done
  # カーネルは /init を動かす
  ln -s usr/bin/init "$pkgdir/init"
  # passwd と su は root の権限で動く
  chmod 4755 "$pkgdir/usr/bin/passwd" "$pkgdir/usr/bin/su"
  ln -s systemctl "$pkgdir/usr/bin/poweroff"
  ln -s systemctl "$pkgdir/usr/bin/reboot"
  ln -s swapon "$pkgdir/usr/bin/swapoff"
  for p in lsmod rmmod insmod; do
    ln -s modprobe "$pkgdir/usr/bin/$p"
  done
  # ユーザーとグループ (shadow-utils と同じ名前): useradd が呼ばれた名前で動きを変える
  for p in usermod userdel groupadd groupdel; do
    ln -s useradd "$pkgdir/usr/bin/$p"
  done
  for p in aish-complete aish-suggest aish-pick aish-edit aish-wait aish-map; do
    install -Dm755 "$top/shell/target/aarch64-unknown-linux-musl/release/$p" "$pkgdir/usr/lib/aish/plugins/$p"
  done
  # sh として呼ばれた aish は POSIX の sh として動く
  ln -s aish "$pkgdir/usr/bin/sh"
  # aipkg の短い名前 (sudo ap -Syu。sudo はシェルの alias を見ないのでリンクにする)
  ln -s aipkg "$pkgdir/usr/bin/ap"

  cp -r "$top/etc" "$pkgdir/etc"
  # 起動のときに起こすモジュール (desktop などのパッケージが置く)
  install -d "$pkgdir/etc/modules-load.d"
  # OS の名前 (OS を知りたいプログラムは /etc/os-release を読む。ID=aios)
  install -Dm644 "$startdir/os-release" "$pkgdir/usr/lib/os-release"
  ln -s ../usr/lib/os-release "$pkgdir/etc/os-release"
  # ~/.aishrc の見本 (使うときに cp する)
  install -Dm644 "$startdir/aishrc.example" "$pkgdir/usr/share/aish/aishrc.example"
  chmod 600 "$pkgdir/etc/shadow"
  chmod 440 "$pkgdir/etc/sudoers"

  install -d -m700 "$pkgdir/root"
  install -d -m1777 "$pkgdir/tmp"
  install -d "$pkgdir/home" "$pkgdir/run" "$pkgdir/var/log" \
    "$pkgdir/var/lib/aipkg/local" "$pkgdir/var/cache/aipkg"
}
