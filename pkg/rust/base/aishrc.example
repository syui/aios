# ~/.aishrc の見本: cp /usr/share/aish/aishrc.example ~/.aishrc
# aish が対話するときに、/etc/aishrc のあとで読む (as で開いて、ar で読みなおす)

# powerline のプロンプト。アイコンと区切りは aifont (Nerd Font と同じ位置) の文字なので、端末のフォントが要る。使うなら # をはずす
#plugin aish-powerline

# キーを変える: bindkey KEY PLUGIN:WIDGET (bindkey だけで一覧、bindkey -r KEY で外す)
#bindkey C-g pick:dir
