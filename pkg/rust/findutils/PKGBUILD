# aios (aarch64) 用。Arch なら: CARCH=aarch64 makepkg (ほかでは bin/mkpkg.sh pkg/rust/findutils)
# xargs-max-procs.patch: xargs の -P (いくつかを並べて動かす)。配布元はオプションを受けとるだけで「NOT IMPLEMENTED」
# (0.11.0 と main)。GNU と同じく、max-procs こ走っていれば、どれかが終わるのを待って次を (0 は上限なし)。255 で
# 終わるか殺されたものがあれば、走っているものを待ってから止める。テスト (tests/test_xargs.rs) も。配布元に出すまで
pkgname=findutils
pkgver=0.11.0
pkgrel=2
pkgdesc='Rust implementation of GNU findutils: find, xargs (uutils)'
arch=('aarch64')
url='https://github.com/uutils/findutils'
license=('MIT')
makedepends=('git' 'rustup' 'aarch64-linux-gnu-gcc')
source=("git+https://github.com/uutils/findutils#tag=$pkgver"
        xargs-max-procs.patch)
sha256sums=('SKIP'
            '5b1a424c43e7e101c8f20db18de6a47216449357894758d90cfaecd9c87e9716')

prepare() {
  cd findutils
  git checkout -- .
  patch -p1 < "$srcdir/xargs-max-procs.patch"
}

build() {
  . "$startdir/../cross.sh"
  cd findutils
  # 配布元の Cargo.lock のうち、直った版が出ているもの (cargo audit): chacha20 (0.10.0 は yanked)
  cargo_update chacha20@0.10.2
  musl_build --bin find --bin xargs
}

package() {
  cd findutils
  local out=target/aarch64-unknown-linux-musl/release
  install -Dm755 "$out/find" "$pkgdir/usr/bin/find"
  install -Dm755 "$out/xargs" "$pkgdir/usr/bin/xargs"
}
