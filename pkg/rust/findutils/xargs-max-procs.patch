+fn code_result(code: i32) -> Result<CommandResult, CommandExecutionError> {
+    match code {
+        0 => Ok(CommandResult::Success),
+        255 => Err(CommandExecutionError::UrgentlyFailed),
+        _ => Ok(CommandResult::Failure),
+    }
