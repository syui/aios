+/// The commands running at the same time (`-P max-procs`, as in GNU xargs: while `max` are
+/// running, wait for any one of them to finish before starting the next; 0 means no limit).
+/// With 1 (the default) each command is waited for before more input is read, as before.
+struct Running {
+    max: usize,
+    #[cfg(unix)]
+    children: Vec<std::process::Child>,
+}
+
+impl Running {
+    fn new(max: usize) -> Self {
+        Self {
+            max,
+            #[cfg(unix)]
+            children: Vec::new(),
+        }
+    }
+
+    fn run(
+        &mut self,
+        builder: CommandBuilder,
+        result: &mut CommandResult,
+    ) -> Result<(), XargsError> {
+        #[cfg(unix)]
+        if self.max != 1 {
+            while self.max != 0 && self.children.len() >= self.max {
+                self.reap_one(result)?;
+            }
+            match builder.spawn() {
+                Ok(Spawned::Child(c)) => self.children.push(c),
+                Ok(Spawned::Done(r)) => result.combine(r),
+                Err(e) => {
+                    self.wait_all();
+                    return Err(e.into());
+                }
+            }
+            return Ok(());
+        }
+        result.combine(builder.execute()?);
+        Ok(())
+    }
+
+    /// Wait for every command that is still running.
+    fn finish(&mut self, result: &mut CommandResult) -> Result<(), XargsError> {
+        #[cfg(unix)]
+        while !self.children.is_empty() {
+            self.reap_one(result)?;
+        }
+        let _ = result;
+        Ok(())
+    }
+
+    /// Wait for whichever running command finishes first. If it failed so that xargs stops
+    /// (exit status 255, killed by a signal), wait for the others too before returning the error.
+    #[cfg(unix)]
+    // The `Child` that is dropped here has already been reaped by `waitpid`.
+    #[allow(clippy::zombie_processes)]
+    fn reap_one(&mut self, result: &mut CommandResult) -> Result<(), XargsError> {
+        use nix::errno::Errno;
+        use nix::sys::wait::{waitpid, WaitStatus};
+        use nix::unistd::Pid;
+        loop {
+            let (pid, r) = match waitpid(Pid::from_raw(-1), None) {
+                Ok(WaitStatus::Exited(pid, code)) => (pid, code_result(code)),
+                Ok(WaitStatus::Signaled(pid, signal, _)) => (
+                    pid,
+                    Err(CommandExecutionError::Killed {
+                        signal: signal as i32,
+                    }),
+                ),
+                Ok(_) | Err(Errno::EINTR) => continue,
+                Err(e) => {
+                    self.children.clear();
+                    return Err(XargsError::Io(io::Error::from(e)));
+                }
+            };
+            // Already reaped: dropping the `Child` does not wait for it again.
+            let Some(i) = self
+                .children
+                .iter()
+                .position(|c| c.id() == pid.as_raw() as u32)
+            else {
+                continue;
+            };
+            self.children.swap_remove(i);
+            return match r {
+                Ok(r) => {
+                    result.combine(r);
+                    Ok(())
+                }
+                Err(e) => {
+                    self.wait_all();
+                    Err(e.into())
+                }
+            };
+        }
+    }
+
+    #[cfg(unix)]
+    fn wait_all(&mut self) {
+        for mut c in self.children.drain(..) {
+            let _ = c.wait();
+        }
+    }
 }
 
