+#[cfg(unix)]
+#[test]
+fn xargs_max_procs_runs_in_parallel() {
+    // Four one-second sleeps, four at a time: about one second, not four.
+    let start = std::time::Instant::now();
+    ucmd()
+        .args(&["-P", "4", "-n", "1", "sleep"])
+        .pipe_in("1 1 1 1")
+        .succeeds()
+        .no_output();
+    assert!(start.elapsed() < std::time::Duration::from_secs(3));
+
+    // 0 means as many as possible.
+    let start = std::time::Instant::now();
+    ucmd()
+        .args(&["-P", "0", "-n", "1", "sleep"])
+        .pipe_in("1 1 1 1 1 1")
+        .succeeds()
+        .no_output();
+    assert!(start.elapsed() < std::time::Duration::from_secs(3));
+}
+
+#[cfg(unix)]
+#[test]
+fn xargs_max_procs_failure() {
+    let result = ucmd()
+        .args(&[
+            "-P",
+            "2",
+            "-n1",
+            &path_to_testing_commandline(),
+            "-",
+            "--no_print_cwd",
+            "--exit_with_failure",
+        ])
+        .pipe_in("a b c")
+        .run();
+    result.code_is(123);
+    result.no_stderr();
+    // Every command ran, in some order.
+    for arg in ["a", "b", "c"] {
+        assert!(result
+            .stdout_str()
+            .contains(&format!("--exit_with_failure\n{arg}\n")));
+    }
+}
+
+#[cfg(unix)]
+#[test]
+fn xargs_max_procs_urgent_failure() {
+    let result = ucmd()
+        .args(&[
+            "-P",
+            "2",
+            "-n1",
+            &path_to_testing_commandline(),
+            "-",
+            "--no_print_cwd",
+            "--exit_with_urgent_failure",
+        ])
+        .pipe_in("a b")
+        .run();
+    result.code_is(124);
+    assert!(
+        !result.stderr_str().is_empty(),
+        "stderr should not be empty"
+    );
+}
