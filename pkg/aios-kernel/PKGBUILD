# aios のカーネル。/boot/aios に置く (Arch ARM の linux-* が /boot にカーネルを置くのと同じ)
# QEMU では bin/run.sh が disk.img の /boot/aios を読んで起動する (小さなブートローダーのかわり)
# initramfs は空にして作るので、ルートはディスク (bin/mkdisk.sh)
pkgname=aios-kernel
pkgver=0.1.0
pkgrel=1
pkgdesc='The aios kernel (aarch64, QEMU virt)'
arch=('aarch64')
url='https://github.com/syui/aios'
license=('MIT')
makedepends=('rustup')

pkgver() {
  cd "$startdir/../.."
  printf '0.1.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$startdir/../.."
  unset CFLAGS CXXFLAGS LDFLAGS RUSTFLAGS
  # 作業中の開発用カーネル (target/.../debug) とは別の場所に作る
  AIOS_INITRD=none AIOS_RELEASE="$pkgver-$pkgrel" CARGO_TARGET_DIR="$srcdir/target" \
    cargo build --release -p aios
}

package() {
  install -Dm644 "$srcdir/target/aarch64-unknown-none-softfloat/release/aios" "$pkgdir/boot/aios"
}
