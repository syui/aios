# test/linux-vm.sh で作る Linux (arm64、QEMU の virt) の設定: make tinyconfig に足すもの。
# ロボット (test/sysdiff.c) をふつうの人 (nobody) で動かすのに要るものだけ: シリアル、initramfs、ext4 と tmpfs、
# virtio-blk、ユーザー、ロボットが呼ぶシステムコール (posix_fadvise は ADVISE_SYSCALLS)、AF_UNIX のソケット (NET と UNIX。
# AF_INET の socketpair が EOPNOTSUPP になるよう INET も)。ページは 4 KiB (パイプの箱)。ここを変えると作りなおす
CONFIG_EXPERT=y
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_ARM_AMBA=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_FILE_LOCKING=y
CONFIG_POSIX_TIMERS=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_EXT4_FS=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_AF_UNIX_OOB=y
CONFIG_INET=y
# AppArmor (test/apparmor.c を rootexec で動かし、aios と同じプロファイルのバイナリを読ませて答えをくらべる。
# プロファイルを読まなければ、どのプロセスにも決まりはない)
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
# Landlock (test/landlockabi.c)。LSM の並びは Linux の既定と同じく landlock が先。namespace の permission を見るので、
# ユーザーと UTS の namespace も (unshare(CLONE_NEWUSER) をだれでも)
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock,apparmor"
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
# UEFI のランタイムサービスと efivarfs (LINUX_EFI=1 で起こしたとき。test/efivarfs.c)
CONFIG_EFI=y
CONFIG_EFIVAR_FS=y
# nf_tables (nftables の手本: test/nftables.c と test/nfteval.c。inet の表は IPv6 も要る。式は核のもの (payload meta cmp bitwise
# immediate lookup range counter など) と log limit reject quota)
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_LOG=y
CONFIG_NF_LOG_SYSLOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_QUOTA=y
# virtio-net と ip=dhcp (LINUX_NET で QEMU のユーザーネットワークに: test/nfteval.c。口がなければ何も変わらない)
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
# conntrack (nftables の段階 3: ct state、ct mark、notrack、/proc/net/nf_conntrack。test/nfteval.c)
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CONNTRACK_PROCFS=y
CONFIG_NFT_CT=y
# seccomp のフィルタと user notification (test/seccomp.c、test/seccompnotify.c)
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
