abi <abi/4.0>,

include <tunables/global>

@{ailog_cfg}=@{HOME}/.config/ai.syui.log
@{claude_exe}=@{HOME}/.local/share/claude/versions/* /usr/local/bin/global/**/@anthropic-ai/claude-code/bin/claude.exe

profile ailog-bot {
  include <abstractions/base>
  include <abstractions/nameservice>
  include <abstractions/ssl_certs>

  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network netlink raw,
  unix,

  signal (receive) peer=unconfined,
  signal (send, receive) peer=ailog-bot,
  signal (send) peer=ailog-bot-claude,

  /usr/bin/ailog mrix,
  /usr/bin/{bash,sh} mrix,
  @{claude_exe} Px -> ailog-bot-claude,

  /dev/tty rw,

  owner @{HOME}/ r,
  owner @{ailog_cfg}/{,**} rwlk,

  owner @{PROC}/@{pid}/** r,
  @{sys}/fs/cgroup/** r,
  @{sys}/devices/system/cpu/** r,

  deny @{HOME}/.ssh{,/**} rwl,
  deny @{HOME}/.gnupg/private-keys-v1.d{,/**} rwl,
}

profile ailog-bot-claude {
  include <abstractions/base>
  include <abstractions/nameservice>
  include <abstractions/ssl_certs>

  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network netlink raw,
  unix,

  signal (receive) peer=unconfined,
  signal (receive) peer=ailog-bot,
  signal (send, receive) peer=ailog-bot-claude,
  ptrace (read, trace, readby, tracedby) peer=ailog-bot-claude,

  /{,**} r,
  /usr/** mrix,
  @{claude_exe} mrix,

  /dev/ptmx rw,
  /dev/pts/* rw,
  /dev/tty rw,

  owner @{HOME}/.claude/{,**} rwlk,
  owner @{HOME}/.claude.json* rwlk,
  owner @{HOME}/.cache/{,**} rwlk,
  owner @{HOME}/.local/state/claude/{,**} rwlk,
  owner @{ailog_cfg}/{,**} rwlk,
  owner /tmp/** rwlk,
  owner /var/tmp/** rwlk,
  owner /dev/shm/** rwlk,
  owner /run/user/*/cc-socks/{,**} rw,

  deny @{ailog_cfg}/.env rwl,
  deny @{ailog_cfg}/config.json wl,
  deny @{ailog_cfg}/bot/{CLAUDE.md,.mcp.json} wl,
  deny @{ailog_cfg}/bot/.claude/** wl,
  deny @{HOME}/.claude/{settings.json,settings.local.json,CLAUDE.md} wl,
  deny @{HOME}/.claude/{agents,commands,hooks,plugins,skills}/** wl,
  deny @{HOME}/.ssh{,/**} rwl,
  deny @{HOME}/.gnupg/private-keys-v1.d{,/**} rwl,
  deny @{HOME}/.config/github-copilot{,/**} rwl,
  deny /usr/bin/{sudo,sudo-rs,su,su-rs,pkexec,run0,doas,crontab} x,
  deny /usr/bin/{systemctl,systemd-run,busctl,machinectl,dbus-send,gdbus,gpg-connect-agent,tmux,screen} x,
}
