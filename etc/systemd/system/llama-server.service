# llama-server: ローカルの LLM (llama.cpp の llama serve)。OpenAI と同じ API を http://127.0.0.1:8080/v1/ に出す
# (chat/completions、completions、embeddings、models。/health で様子)。llama.cpp のパッケージ (ap -S llama.cpp) と
# モデル /var/lib/ai/model.gguf (GGUF。/var/lib/ai/models/ に置いたものへのリンク) がそろえば、起動のたびに動く。
# どちらかがなければ起こさない (aiwatch と同じく、はじめから有効にしておく)。
# 変えるときは /etc/systemd/system/llama-server.service.d/local.conf に、たとえば
#   [Service]
#   Environment=LLAMA_ARG_CTX_SIZE=8192 LLAMA_ARG_THREADS=4
# (llama serve --help の LLAMA_ARG_*。モデルを替えたら systemctl restart llama-server)
[Unit]
Description=llama.cpp server: a local LLM over HTTP (OpenAI-compatible API on 127.0.0.1:8080)
ConditionPathExists=/opt/c/bin/llama
ConditionPathExists=/var/lib/ai/model.gguf
After=networkd.service

[Service]
User=nobody
# LLAMA_ARG_CTX_SIZE: 言わなければ llama.cpp はモデルの学んだ長さ (Gemma 4 は 131072) の会話の入れ物 (KV cache) を取り、
# 2-3 GB の aios では入らない (failed to fit params)。4096 なら足りる (長くしたいときは local.conf で)
# LLAMA_ARG_REASONING=off: 答える前の考えごと (thinking) をしない。Gemma 4 はふつう 100-200 トークン考えてから答えるので、
# CPU では答えがそれだけおそくなる (考えたいときは local.conf で auto に。API なら chat_template_kwargs の enable_thinking)
Environment=LLAMA_ARG_MODEL=/var/lib/ai/model.gguf LLAMA_ARG_HOST=127.0.0.1 LLAMA_ARG_PORT=8080 LLAMA_ARG_CTX_SIZE=4096 LLAMA_ARG_REASONING=off
ExecStart=/opt/c/bin/llama serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
