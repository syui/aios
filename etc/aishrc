# /etc/aishrc: aish が対話するときに読む。そのあと ~/.aishrc を読む
# (sh として呼ばれたときは読まない。POSIX の sh と同じく $ENV だけ)
# ai/dot の .zshrc と同じ使いごこちに: alias、cd のあとの ls (chpwd)
# 機能の多くはプラグイン (aish とは別のプログラム。/usr/lib/aish/plugins)。plugin で読み、bindkey でキーを変える。
# powerline のプロンプトなどほかのプラグインは、パッケージ ([shell] リポジトリ) を入れて ~/.aishrc で読む
# (~/.aishrc の見本: /usr/share/aish/aishrc.example)
# キー: Tab 補完 / ↑↓ 履歴 / C-r 履歴 / C-f ファイル / C-g rg で探す / C-o よく使うパス / C-j 最近のディレクトリ / C-k cd .. / C-p C-p コピー

# 基本のプラグイン (base に入っている)
[ -z "$AISH_MCP" ] && plugin aish-complete && plugin aish-suggest
plugin aish-pick
# aish --mcp (Claude が aish を使う入り口。AISH_MCP=1) では、ファイルを確かに読み書きする aish-edit と、
# 何かが起きるまで待つ aish-wait も
[ -n "$AISH_MCP" ] && plugin aish-edit && plugin aish-wait

alias ls='ls -a --color=auto'
alias ll='ls -alh --color=auto'
alias df='df -H'
alias as='${EDITOR:-vi} ~/.aishrc'
alias ar='exec aish'
alias u='sudo ap -Syu'

HISTSIZE=10000

# cd のあとの ls は人のため (aish --mcp では出力にまざらないように)
[ -z "$AISH_MCP" ] && chpwd() { ls; }

# プロンプト: [ユーザー@ホスト ディレクトリ]$ (\u \h \W \$ は bash と同じ)
PS1='[\u@\h \W]\$ '
