# /etc/profile: ログインシェル (aish、sh。zsh は /etc/zsh/zprofile から sh のふりで) が最初に読む
# /opt/c/bin は C の拡張 ([c] のパッケージ、firefox など)。ログインのあとで aipkg -S で入れても
# すぐ使えるように、まだなくても入れておく。~/.local/bin は uv (uv python install の python3.15、
# uv tool install のもの) や pip --user が置くところ (XDG。Arch などの多くのディストリと同じく、先に)
export PATH=$HOME/.local/bin:/usr/local/bin:/usr/bin:/opt/c/bin
umask 022
# プロンプト (sh の名前の aish 用。aish は /etc/aishrc の powerline のプロンプトに、zsh は zsh の書き方なので置かない)。
# [ユーザー@ホスト ディレクトリ]$
[ -n "${ZSH_VERSION:-}" ] || PS1='[\u@\h \W]\$ '
# パッケージの設定 (cargo のリンカなど)。Arch と同じく /etc/profile.d/*.sh を読む
for f in /etc/profile.d/*.sh; do
  [ -r "$f" ] && . "$f"
done
