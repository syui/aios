{
  "branch": "unix",
  "arch": "aarch64",
  "updated": "2026-10-08",
  "repo": {
    "rust":    { "lang": "Rust",  "prefix": "/usr" },
    "c":       { "lang": "C/C++", "prefix": "/opt/c" },
    "shell":   { "lang": "Rust",  "prefix": "/usr/lib/aish/plugins" },
    "desktop": { "lang": "Rust",  "prefix": "/usr" },

    "npm":     { "lang": "JS/TS",  "prefix": "/usr/local", "via": "npm install -g / pnpm add -g" },
    "uv":      { "lang": "Python", "prefix": "~/.local",   "via": "uv python install / uv tool install" }
  },

  "toolchain": {
    "rust":  { "via": "ap -S cargo base-devel", "target": "aarch64-unknown-linux-musl",
               "link": "dynamic with cc (zig), like Alpine. static: RUSTFLAGS=\"-C target-feature=+crt-static\"" },
    "c":     { "via": "ap -S base-devel", "cc": "zig cc (static by default, cc -dynamic for dynamic)" }
  },

  "graphics": {
    "vulkan": "lavapipe (mesa, on the CPU)", "gl": "llvmpipe (mesa, EGL / GLES)", "wsi": "Wayland (aiwm)",
    "pkg":    "ap -S desktop mesa vulkan-loader xkeyboard-config alsa-lib libxkbcommon",
    "tested": ["vkcube", "ai/engine (ash + winit + cpal)"]
  },

  "aish": {
    "plugins": ["complete", "suggest", "pick", "edit", "wait", "map", "fix", "sys", "pkg", "claude"],
    "mcp":     "aish --mcp (run, job, and the plugins' tools)"
  },

  "kernel": {
    "boot": ["UEFI (aiboot)", "Linux arm64 Image", "DTB", "Raspberry Pi 3"],
    "cpu":  ["SMP (PSCI, spin-table)", "GICv2", "GICv3"],
    "mem":  ["swap", "memfd"],
    "fs":   ["ext4 (jbd2, htree)", "ext2", "vfat", "tmpfs", "procfs (stat, net, vmstat, diskstats)", "/dev/fd", "initramfs", "inotify"],
    "dev":  ["virtio-blk", "virtio-net", "virtio-gpu", "virtio-input", "virtio-sound", "SD", "UART", "modules"],
    "net":  ["IPv4 (TCP, UDP, DHCP)", "ICMP (ping, raw)", "unix sockets (SCM_RIGHTS)"],
    "proc": ["signal", "futex", "epoll", "pty", "pidfd", "vDSO", "PT_INTERP", "umask", "capget"],
    "todo": ["seccomp", "namespace", "fine-grained lock (BKL)"]
  },

  "pkg": {
    "aios": {
      "rust":    { "aiboot": "0.0.1", "aikernel": "0.0.1", "base": "0.0.1", "aigpt": "0.0.1", "ailog": "0.0.1", "aimg": "0.0.1" },
      "c":       { "base-devel": "0.0.1", "claude": "0.0.1" },
      "shell":   { "aish-powerline": "0.0.1" },
      "desktop": { "aifont": "0.0.1", "aisplash": "0.0.1", "aiterm": "0.0.1", "aiwm": "0.0.1", "desktop": "0.0.1" }
