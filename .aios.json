{
  "branch": "unix",
  "arch": "aarch64",
  "updated": "2026-10-23",
  "repo": {
    "rust":    { "lang": "Rust",  "prefix": "/usr" },
    "c":       { "lang": "C/C++", "prefix": "/opt/c" },
    "shell":   { "lang": "Rust",  "prefix": "/usr/lib/aish/plugins" },
    "desktop": { "lang": "Rust",  "prefix": "/usr" },

    "npm":     { "lang": "JS/TS",  "prefix": "/usr/local", "via": "npm install -g / pnpm add -g" },
    "uv":      { "lang": "Python", "prefix": "~/.local",   "via": "uv python install / uv tool install" }
  },

  "toolchain": {
    "rust":  { "via": "ap -S cargo base-devel", "target": "aarch64-unknown-linux-musl",
               "link": "dynamic with cc (zig), like Alpine. static: RUSTFLAGS=\"-C target-feature=+crt-static\"" },
    "c":     { "via": "ap -S base-devel", "cc": "zig cc (static by default, cc -dynamic for dynamic)" }
  },

  "graphics": {
    "vulkan": "lavapipe (mesa, on the CPU)", "gl": "llvmpipe (mesa, EGL / GLES)", "wsi": "Wayland (aiwm)",
    "pkg":    "ap -S aiwm mesa vulkan-loader xkeyboard-config alsa-lib libxkbcommon",
    "tested": ["vkcube", "ai/engine (ash + winit + cpal)"]
  },

  "aish": {
    "plugins": ["complete", "suggest", "pick", "edit", "wait", "map", "fix", "sys", "pkg", "claude"],
    "mcp":     "aish --mcp (run, job, and the plugins' tools)"
  },

  "kernel": {
    "core":  ["boot", "main", "memlayout", "mmio", "spinlock", "cell", "kalloc", "heap", "oom", "tlsf", "mem", "vm", "trap", "irq", "timer", "smp", "dtb",
              "uart", "console", "kmsg", "tty", "proc", "signal", "syscall", "exec", "file", "locks", "futex", "sysfile", "vfs", "statc", "fastdir", "fs", "tmpfs",
              "initrd", "cred", "crypto", "rand", "parts"],
    "extra": ["aiproc", "bcm2835_rng", "block", "efi", "epoll", "extfs", "gpu", "htree", "inet", "inotify", "input", "jbd2", "landlock",
              "module", "net", "netif", "ns", "procfs", "prof", "fail", "trace", "why", "sd", "seccomp", "socket", "sound", "swap", "sysctl", "sysfs",
              "timerfd", "unix", "vdso", "vfat", "virtio", "virtio_blk", "virtio_net", "virtio_rng"],
    "quirk": ["tty-root-fdlink", "sound-min-period", "qemu-uart-burst"],
    "todo":  ["fine-grained lock (BKL)"]
  },

  "pkg": {
    "aios": {
      "rust":    { "aiboot": "0.0.1", "aikernel": "0.0.1", "base": "0.0.1", "aigpt": "0.0.1", "ailog": "0.0.1", "aimg": "0.0.1" },
      "c":       { "base-devel": "0.0.1", "claude": "0.0.1" },
      "shell":   { "aish-powerline": "0.0.1" },
      "desktop": { "aifont": "0.0.1", "aiterm": "0.0.1", "aiwm": "0.0.1" }
    },

    "linux": {
      "rust": {
        "awk": "0.1.0.20261021", "brush": "0.4.0", "coreutils": "0.12.0",
        "findutils": "0.10.0", "grep": "0.2.0", "sudo-rs": "0.2.15", "tar": "0.1.0.20261022",
        "ripgrep": "15.2.0", "fd": "10.5.0", "uv": "0.13.5"
      },
      "c": {
        "alsa-lib": "1.2.16.1", "alsa-utils": "1.2.16", "atk": "2.38.0",
        "ca-certificates": "20261020", "cairo": "1.18.6", "curl": "8.23.0", "egl-headers": "0.0.1.re964211",
        "expat": "2.9.0", "ffmpeg": "9.0.2", "firefox": "158.0.1", "fontconfig": "2.18.3",
        "freetype2": "2.15.0", "fribidi": "1.0.17", "gdk-pixbuf2": "2.44.8", "git": "2.56.0",
        "glib2": "2.90.1", "gtk3": "3.24.52", "harfbuzz": "15.0.0", "libdrm": "2.4.134",
        "libepoxy": "1.5.10", "libffi": "3.8.0", "libpng": "1.6.59", "libxkbcommon": "1.13.2",
        "llvm": "23.1.4", "mbedtls": "4.2.0", "mesa": "26.2.5", "musl": "1.2.6",
        "pango": "1.58.2", "pcre2": "10.49", "pixman": "0.46.4", "pkgconf": "3.0.10", "vulkan-headers": "1.4.365",
        "vulkan-loader": "1.4.365", "vulkan-tools": "1.4.365", "wayland": "1.26.0", "wayland-protocols": "1.49",
        "xkeyboard-config": "2.48", "zig": "0.17.0", "zlib": "1.3.2",

        "ncurses": "6.6", "libevent": "2.1.13",
        "zsh": "5.9.2", "vim": "9.2.1225", "tmux": "3.8", "openssh": "10.6p1", "jq": "1.8.2",
        "libunwind": "0.16.0", "nodejs": "26.12.1", "cargo": "1.99.1", "less": "710",

        "procps-ng": "4.0.7", "gawk": "5.4.1", "libarchive": "3.8.10", "gzip": "1.15", "xz": "5.8.4",
        "bzip2": "1.0.8", "zstd": "1.5.7", "patch": "2.8", "make": "4.4.1", "file": "5.48", "tree": "2.3.2",
        "toybox": "0.8.15", "iproute2": "7.3.0", "diffutils": "3.12", "sed": "4.10", "vlc": "3.0.24"
      },
      "npm": { "pnpm": "12.9.1", "@anthropic-ai/claude-code": "2.1.289 (ap -S claude)" },
      "uv":  { "python": "3.15.1" }
    }
  }
}
