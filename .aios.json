{
  "branch": "main",
  "arch": "aarch64",
  "updated": "2026-11-13",
  "repo": {
    "rust":    { "lang": "Rust",  "prefix": "/usr" },
    "c":       { "lang": "C/C++", "prefix": "/opt/c" },
    "desktop": { "lang": "Rust",  "prefix": "/usr" },

    "npm":     { "lang": "JS/TS",  "prefix": "/usr/local", "via": "npm install -g / pnpm add -g" },
    "uv":      { "lang": "Python", "prefix": "~/.local",   "via": "uv python install / uv tool install" }
  },

  "toolchain": {
    "rust":  { "via": "ap -S cargo base-devel", "target": "aarch64-unknown-linux-musl",
               "link": "dynamic with cc (zig), like Alpine. static: RUSTFLAGS=\"-C target-feature=+crt-static\"" },
    "c":     { "via": "ap -S base-devel", "cc": "zig cc (static by default, cc -dynamic for dynamic)" }
  },

  "graphics": {
    "vulkan": "lavapipe (mesa, on the CPU)", "gl": "llvmpipe (mesa, EGL / GLES)", "wsi": "Wayland (aiwm)",
    "pkg":    "ap -S aiwm mesa vulkan-loader xkeyboard-config alsa-lib libxkbcommon",
    "tested": ["vkcube", "ai/engine (ash + winit + cpal)"]
  },

  "aish": {
    "plugins": ["complete", "suggest", "highlight", "time", "pick", "edit", "wait", "fetch", "git", "map", "fix", "sys", "pkg", "claude", "local", "powerline"],
    "mcp":     "aish --mcp (run, job, and the plugins' tools)"
  },

  "kernel": {
    "core":  ["boot", "main", "memlayout", "mmio", "spinlock", "cell", "kalloc", "heap", "oom", "tlsf", "mem", "vm", "trap", "irq", "timer", "smp", "dtb",
              "uart", "console", "kmsg", "tty", "proc", "signal", "pidfd", "syscall", "exec", "vdso", "cpuvuln", "file", "futex", "sysfile", "vfs", "statc", "fastdir", "fs", "tmpfs",
              "initrd", "cred", "security", "ns", "crypto", "rand", "parts", "why", "debug"],
    "extra": ["aiproc", "apparmor", "bcm2835_rng", "block", "efi", "efirt", "efivarfs", "epoll", "extfs", "gpu", "drm", "kms", "edid", "htree", "inet", "inotify", "locks", "input", "jbd2", "landlock", "lsm_syscalls",
              "module", "net", "addrconf", "netif", "netlink", "nftables", "nfhook", "conntrack", "ctnetlink", "audit", "auditfilter", "procfs", "lockstat", "prof", "fail", "trace", "whylog", "sd", "seccomp", "securityfs", "socket", "splice", "sound", "swap", "sysctl", "sysfs", "sysrq",
              "posix_timers", "timerfd", "signalfd", "unix", "vfat", "virtio", "virtio_blk", "virtio_net", "virtio_rng"],
    "quirk": ["tty-root-fdlink", "sound-min-period", "qemu-uart-burst"]
  },

  "pkg": {
    "aios": {
      "rust":    { "aiboot": "0.0.1", "aikernel": "0.0.1", "base": "0.0.1", "aigpt": "0.0.1", "ailog": "0.0.1", "aimg": "0.0.1" },
      "c":       { "base-devel": "0.0.1", "aimodel": "0.0.1" },
      "desktop": { "aifont": "0.0.1", "aiterm": "0.0.1", "aiwm": "0.0.1" }
    },

    "linux": {
